<Item class="ReplicatedStorage" referent="RBX15"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX14"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[local Config = {}

-- Growth: the player starts as a Hatchling and grows into an Elder.
Config.Stages = {
	{ name = "Hatchling",  xp = 0,    scale = 0.55, dna = 300,  sculpt = 60,  health = 60 },
	{ name = "Juvenile",   xp = 100,  scale = 0.75, dna = 450,  sculpt = 90,  health = 100 },
	{ name = "Adolescent", xp = 300,  scale = 0.95, dna = 600,  sculpt = 120, health = 150 },
	{ name = "Adult",      xp = 700,  scale = 1.20, dna = 800,  sculpt = 160, health = 220 },
	{ name = "Elder",      xp = 1500, scale = 1.40, dna = 1000, sculpt = 200, health = 280 },
}

Config.MaxParts = 40
Config.MinSegments = 2
Config.MaxSegments = 10
Config.NpcCount = 12
Config.FoodCount = 60
Config.WorldRadius = 200
Config.PvP = false -- set true to let players bite each other

function Config.stageForXp(xp)
	local index = 1
	for i, stage in ipairs(Config.Stages) do
		if xp >= stage.xp then
			index = i
		end
	end
	return index
end

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">PartCatalog</string><ProtectedString name="Source"><![CDATA[-- Every attachable part. To add one, copy a line and change the values.
local Catalog = {}

Catalog.Categories = { "Mouths", "Eyes", "Legs", "Arms", "Tails", "Wings", "Weapons", "Decor" }
Catalog.Parts = {}
Catalog.ByCategory = {}

local function add(category, id, name, cost, build, params, stats)
	local def = { id = id, name = name, category = category, cost = cost, build = build, p = params or {}, stats = stats or {} }
	Catalog.Parts[id] = def
	Catalog.ByCategory[category] = Catalog.ByCategory[category] or {}
	table.insert(Catalog.ByCategory[category], def)
end

local bone = Color3.fromRGB(235, 225, 200)
local dark = Color3.fromRGB(50, 40, 40)
local orange = Color3.fromRGB(240, 165, 45)

add("Mouths", "m_grazer", "Grazer Lips", 20, "lips", {}, { diet = "plant", bite = 4 })
add("Mouths", "m_beak", "Beak", 30, "beak", { len = 0.7, w = 0.5, color = orange }, { diet = "both", bite = 7 })
add("Mouths", "m_hook", "Hooked Beak", 45, "beak", { len = 0.8, w = 0.55, hook = true, color = dark }, { diet = "meat", bite = 11 })
add("Mouths", "m_jaws", "Jaws", 40, "jaws", { teeth = 4, len = 0.55 }, { diet = "both", bite = 9 })
add("Mouths", "m_fangs", "Fang Maw", 70, "jaws", { teeth = 6, len = 0.75, fang = true }, { diet = "meat", bite = 15 })
add("Mouths", "m_snout", "Snout", 30, "snout", {}, { diet = "plant", bite = 5, sense = 3 })
add("Mouths", "m_probe", "Proboscis", 35, "probe", {}, { diet = "plant", bite = 4, sense = 2 })
add("Mouths", "m_mandible", "Mandibles", 55, "mandible", {}, { diet = "meat", bite = 12 })
add("Mouths", "m_duck", "Duck Bill", 25, "bill", {}, { diet = "both", bite = 5, charm = 2 })

add("Eyes", "e_round", "Round Eye", 10, "eye", { r = 0.22, pupil = 0.5 }, { sense = 2 })
add("Eyes", "e_cute", "Big Eye", 15, "eye", { r = 0.36, pupil = 0.65, shine = true }, { sense = 3, charm = 3 })
add("Eyes", "e_slit", "Slit Eye", 15, "eye", { r = 0.26, slit = true, iris = Color3.fromRGB(240, 200, 30) }, { sense = 3 })
add("Eyes", "e_stalk", "Stalk Eye", 25, "eye", { r = 0.24, stalk = 0.8, pupil = 0.55 }, { sense = 5 })
add("Eyes", "e_compound", "Bug Eye", 25, "compound", {}, { sense = 5 })
add("Eyes", "e_glow", "Glow Eye", 30, "eye", { r = 0.22, glow = true, iris = Color3.fromRGB(80, 255, 220) }, { sense = 4, charm = 2 })
add("Eyes", "e_sleepy", "Lidded Eye", 12, "eye", { r = 0.28, pupil = 0.5, lid = true }, { sense = 2, charm = 2 })

add("Legs", "l_stub", "Stubby Leg", 20, "leg", { len = 1.0, w = 0.45, foot = "pad", knee = "front" }, { speed = 2, health = 8 })
add("Legs", "l_paw", "Paw Leg", 40, "leg", { len = 1.5, w = 0.4, foot = "paw", knee = "front" }, { speed = 4, jump = 6 })
add("Legs", "l_runner", "Runner Leg", 55, "leg", { len = 2.1, w = 0.28, foot = "paw", knee = "back" }, { speed = 7, jump = 8 })
add("Legs", "l_hoof", "Hoof Leg", 45, "leg", { len = 1.8, w = 0.34, foot = "hoof", knee = "back" }, { speed = 6, health = 5 })
add("Legs", "l_bird", "Talon Leg", 45, "leg", { len = 1.7, w = 0.24, foot = "talon", knee = "back", color = orange }, { speed = 4, attack = 4 })
add("Legs", "l_spider", "Spider Leg", 35, "leg", { len = 1.6, w = 0.18, foot = "point", knee = "out" }, { speed = 3 })
add("Legs", "l_pillar", "Pillar Leg", 50, "leg", { len = 1.8, w = 0.7, foot = "pad", knee = "front" }, { speed = 2, health = 25 })
add("Legs", "l_frog", "Frog Leg", 55, "leg", { len = 1.6, w = 0.38, foot = "web", knee = "out" }, { speed = 3, jump = 22 })

add("Arms", "a_grab", "Grabby Arm", 30, "arm", { len = 1.4, w = 0.26, hand = "fingers" }, { attack = 3, charm = 1 })
add("Arms", "a_claw", "Claw Arm", 50, "arm", { len = 1.5, w = 0.32, hand = "claws" }, { attack = 9 })
add("Arms", "a_pincer", "Pincer", 60, "arm", { len = 1.4, w = 0.3, hand = "pincer" }, { attack = 11, health = 5 })
add("Arms", "a_blade", "Blade Arm", 65, "arm", { len = 1.6, w = 0.22, hand = "blade" }, { attack = 13 })
add("Arms", "a_paddle", "Flipper", 25, "arm", { len = 1.1, w = 0.35, hand = "paddle" }, { speed = 1, health = 5 })
add("Arms", "a_boxer", "Boxer Fist", 45, "arm", { len = 1.2, w = 0.3, hand = "fist" }, { attack = 7 })

add("Tails", "t_simple", "Long Tail", 20, "tail", { len = 2.4, w = 0.5 }, { speed = 1 })
add("Tails", "t_spike", "Spiked Tail", 45, "tail", { len = 2.4, w = 0.5, tip = "spikes" }, { attack = 7 })
add("Tails", "t_club", "Club Tail", 50, "tail", { len = 2.2, w = 0.5, tip = "club" }, { attack = 8, health = 10 })
add("Tails", "t_fish", "Fan Tail", 30, "tail", { len = 1.8, w = 0.5, tip = "fan" }, { speed = 3, charm = 2 })
add("Tails", "t_sting", "Stinger", 60, "tail", { len = 2.6, w = 0.36, tip = "sting", curl = true }, { attack = 12 })
add("Tails", "t_fluff", "Fluffy Tail", 25, "tail", { len = 1.6, w = 0.7, tip = "fluff" }, { charm = 6 })
add("Tails", "t_rattle", "Rattle Tail", 30, "tail", { len = 2.0, w = 0.36, tip = "rattle" }, { attack = 2, charm = 3 })

add("Wings", "w_feather", "Feather Wing", 70, "wing", { style = "feather", span = 2.2 }, { jump = 20, charm = 4 })
add("Wings", "w_bat", "Bat Wing", 70, "wing", { style = "bat", span = 2.3 }, { jump = 20, attack = 2 })
add("Wings", "w_bug", "Insect Wing", 55, "wing", { style = "bug", span = 1.8 }, { jump = 16, speed = 2 })
add("Wings", "w_tiny", "Tiny Wing", 25, "wing", { style = "feather", span = 0.9 }, { jump = 6, charm = 5 })

add("Weapons", "k_horn", "Horn", 25, "spike", { len = 1.1, r = 0.22 }, { attack = 5 })
add("Weapons", "k_curve", "Curved Horn", 30, "spike", { len = 1.4, r = 0.22, bend = 75 }, { attack = 6 })
add("Weapons", "k_ram", "Ram Horn", 45, "spike", { len = 2.0, r = 0.28, bend = 250 }, { attack = 8, health = 8 })
add("Weapons", "k_antler", "Antler", 40, "antler", {}, { attack = 5, charm = 5 })
add("Weapons", "k_tusk", "Tusk", 35, "spike", { len = 1.2, r = 0.16, bend = -60 }, { attack = 7 })
add("Weapons", "k_row", "Spine Row", 40, "row", {}, { attack = 4, health = 10 })
add("Weapons", "k_plate", "Armor Plate", 40, "plate", {}, { health = 25 })
add("Weapons", "k_shell", "Shell", 80, "shell", {}, { health = 55, speed = -2 })

add("Decor", "d_ear", "Pointed Ear", 8, "ear", { w = 0.4, h = 0.8 }, { sense = 2 })
add("Decor", "d_floppy", "Floppy Ear", 8, "ear", { w = 0.45, h = 1.1, floppy = true }, { sense = 2, charm = 2 })
add("Decor", "d_round", "Round Ear", 8, "ear", { w = 0.7, h = 0.65 }, { sense = 2, charm = 2 })
add("Decor", "d_feather", "Feather Tuft", 10, "tuft", {}, { charm = 5 })
add("Decor", "d_crest", "Crest Sail", 15, "sail", {}, { charm = 6 })
add("Decor", "d_frill", "Neck Frill", 20, "frill", {}, { charm = 6, health = 5 })
add("Decor", "d_antenna", "Antenna", 10, "antenna", {}, { sense = 5 })
add("Decor", "d_whisker", "Whiskers", 5, "whisker", {}, { sense = 3 })
add("Decor", "d_puff", "Fur Puff", 5, "puff", {}, { charm = 3 })
add("Decor", "d_glow", "Glow Orb", 15, "orb", {}, { charm = 7 })
add("Decor", "d_flower", "Flower", 10, "flower", {}, { charm = 6 })
add("Decor", "d_shroom", "Mushroom", 10, "shroom", {}, { charm = 4 })
add("Decor", "d_crystal", "Crystal", 20, "crystal", {}, { charm = 6, health = 4 })
add("Decor", "d_gill", "Gills", 10, "gill", {}, { charm = 3 })
add("Decor", "d_nostril", "Nostril", 3, "nostril", {}, { sense = 1 })

Catalog.Heads = {
	{ id = "round",  name = "Round",  size = Vector3.new(1.0, 1.0, 1.0) },
	{ id = "long",   name = "Long",   size = Vector3.new(0.8, 0.8, 1.55) },
	{ id = "wide",   name = "Wide",   size = Vector3.new(1.55, 0.85, 1.0) },
	{ id = "flat",   name = "Flat",   size = Vector3.new(1.25, 0.6, 1.3) },
	{ id = "tall",   name = "Tall",   size = Vector3.new(0.85, 1.45, 0.9) },
	{ id = "hammer", name = "Hammer", size = Vector3.new(2.4, 0.65, 0.75) },
	{ id = "chunky", name = "Chunky", size = Vector3.new(1.35, 1.25, 1.2) },
}

Catalog.Brushes = { "Blob", "Spike", "Ridge", "Plate", "Wart", "Strand", "Gem" }

Catalog.Palette = {}
for _, hex in ipairs({
	"e84a4a", "f2833a", "f5c33b", "f4e86a", "a6d649", "4fae4a", "2e7d5b", "35b8a6",
	"4ec3e8", "3b7ddd", "4a4ac2", "8b55d6", "c455b8", "f07aa8", "f7c6c7", "ffffff",
	"c9c9c9", "6e6e75", "2b2b30", "8a5a38", "c49a6c", "ead9b0", "5a3d5c", "123c3a",
}) do
	table.insert(Catalog.Palette, Color3.fromHex(hex))
end

Catalog.Patterns = { "Belly", "Stripes", "Spots", "Plain" }
Catalog.Materials = { "SmoothPlastic", "Plastic", "Fabric", "Slate", "Metal", "Glass", "Neon" }

return Catalog
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">CreatureData</string><ProtectedString name="Source"><![CDATA[-- The saved description of a creature, plus validation, stats and random NPCs.
local Config = require(script.Parent.Config)
local Catalog = require(script.Parent.PartCatalog)

local Builder = require(script.Parent.CreatureBuilder)

local Data = {}

-- move every part onto the skin: "on" is a spine index or "head", dir points outward
local function seat(d)
	local shapes = Builder.ellipsoids(d)
	for _, e in ipairs(d.parts) do
		if e.on then
			local shape = e.on == "head" and shapes[#shapes] or shapes[e.on]
			local dir = Vector3.new(e.nrm[1], e.nrm[2], e.nrm[3]).Unit
			local point = shape.c + dir / (dir / shape.r).Magnitude
			local normal = ((point - shape.c) / (shape.r * shape.r)).Unit
			e.pos = { point.X, point.Y, point.Z }
			e.nrm = { normal.X, normal.Y, normal.Z }
			e.on = nil
		end
	end
	return d
end

local function num(v, lo, hi, default)
	if type(v) ~= "number" or v ~= v then
		return default
	end
	return math.clamp(v, lo, hi)
end

local function vec(v, lo, hi)
	v = type(v) == "table" and v or {}
	return { num(v[1], lo, hi, 0), num(v[2], lo, hi, 0), num(v[3], lo, hi, 0) }
end

local function oneOf(v, list, default)
	return table.find(list, v) and v or default
end

local function colorIndex(v, default)
	return math.floor(num(v, 1, #Catalog.Palette, default))
end

function Data.default()
	local function part(id, on, nrm, mirrored, size)
		return { id = id, on = on, pos = { 0, 0, 0 }, nrm = nrm, s = size or 1, rot = 0, m = mirrored }
	end
	return seat({
		name = "Sprout",
		spine = { { r = 0.8, y = 0.1 }, { r = 1.0, y = 0 }, { r = 0.8, y = 0 } },
		head = { id = "round", scale = 1 },
		colors = { 9, 16, 2 },
		pattern = "Belly",
		material = "SmoothPlastic",
		parts = {
			part("e_cute", "head", { 0.45, 0.35, -0.8 }, true),
			part("m_grazer", "head", { 0, -0.3, -1 }, false),
			part("l_stub", 1, { 0.8, -0.6, 0 }, true),
			part("l_stub", 3, { 0.8, -0.6, 0 }, true),
			part("t_simple", 3, { 0, 0.1, 1 }, false, 0.8),
		},
		sculpt = {},
	})
end

-- Never trust the client: rebuild the table field by field.
function Data.sanitize(raw)
	if type(raw) ~= "table" then
		return Data.default()
	end
	local out = {}
	out.name = type(raw.name) == "string" and string.sub(raw.name, 1, 20) or "Creature"

	out.spine = {}
	local spine = type(raw.spine) == "table" and raw.spine or {}
	for i = 1, math.min(#spine, Config.MaxSegments) do
		local seg = type(spine[i]) == "table" and spine[i] or {}
		table.insert(out.spine, { r = num(seg.r, 0.3, 2, 1), y = num(seg.y, -2, 3, 0) })
	end
	while #out.spine < Config.MinSegments do
		table.insert(out.spine, { r = 0.8, y = 0 })
	end

	local head = type(raw.head) == "table" and raw.head or {}
	local headIds = {}
	for _, h in ipairs(Catalog.Heads) do
		table.insert(headIds, h.id)
	end
	out.head = { id = oneOf(head.id, headIds, "round"), scale = num(head.scale, 0.5, 2, 1) }

	local colors = type(raw.colors) == "table" and raw.colors or {}
	out.colors = { colorIndex(colors[1], 9), colorIndex(colors[2], 16), colorIndex(colors[3], 2) }
	out.pattern = oneOf(raw.pattern, Catalog.Patterns, "Belly")
	out.material = oneOf(raw.material, Catalog.Materials, "SmoothPlastic")

	out.parts = {}
	local parts = type(raw.parts) == "table" and raw.parts or {}
	for i = 1, math.min(#parts, Config.MaxParts) do
		local e = parts[i]
		if type(e) == "table" and type(e.id) == "string" and Catalog.Parts[e.id] then
			table.insert(out.parts, {
				id = e.id,
				pos = vec(e.pos, -20, 20),
				nrm = vec(e.nrm, -1, 1),
				s = num(e.s, 0.4, 2.2, 1),
				rot = num(e.rot, -360, 360, 0),
				m = e.m == true,
				c = e.c ~= nil and colorIndex(e.c, 1) or nil,
			})
		end
	end

	out.sculpt = {}
	local sculpt = type(raw.sculpt) == "table" and raw.sculpt or {}
	for i = 1, math.min(#sculpt, Config.Stages[#Config.Stages].sculpt) do
		local d = sculpt[i]
		if type(d) == "table" then
			table.insert(out.sculpt, {
				b = oneOf(d.b, Catalog.Brushes, "Blob"),
				pos = vec(d.pos, -20, 20),
				nrm = vec(d.nrm, -1, 1),
				s = num(d.s, 0.1, 1.5, 0.4),
				c = colorIndex(d.c, 1),
				m = d.m == true,
			})
		end
	end
	return out
end

function Data.cost(data)
	local total = math.max(0, #data.spine - 3) * 25
	for _, entry in ipairs(data.parts) do
		total += Catalog.Parts[entry.id].cost
	end
	return total
end

function Data.fits(data, stageIndex)
	local stage = Config.Stages[stageIndex]
	return Data.cost(data) <= stage.dna and #data.sculpt <= stage.sculpt
end

function Data.stats(data, stageIndex)
	local stage = Config.Stages[stageIndex]
	local s = { health = stage.health, speed = 12, jump = 35, attack = 0, bite = 2, sense = 0, charm = 0 }
	local plant, meat, legs = false, false, 0
	local best = {}
	for _, entry in ipairs(data.parts) do
		local def = Catalog.Parts[entry.id]
		local count = entry.m and 2 or 1
		for key, value in pairs(def.stats) do
			if key == "diet" then
				plant = plant or value ~= "meat"
				meat = meat or value ~= "plant"
			elseif key == "speed" or key == "jump" then
				-- movement stats use the best part of each kind so spamming does not stack
				local slot = key .. def.category
				best[slot] = best[slot] or { key = key, value = value }
				best[slot].value = math.max(best[slot].value, value)
			elseif key == "bite" then
				s.bite = math.max(s.bite, value)
			else
				s[key] += value * count
			end
		end
		if def.category == "Legs" then
			legs += count
		end
	end
	for _, item in pairs(best) do
		s[item.key] += item.value
	end
	if legs == 0 then
		s.speed *= 0.65
	end
	s.speed = math.clamp(s.speed, 8, 32)
	s.jump = math.clamp(s.jump, 25, 90)
	-- a creature with no mouth can still nibble plants
	if not plant and not meat then
		plant = true
	end
	s.plant, s.meat = plant, meat
	s.diet = (plant and meat) and "Omnivore" or (meat and "Carnivore" or "Herbivore")
	return s
end

function Data.random(rng)
	local d = Data.default()
	d.name = "Wild"
	d.spine = {}
	local count = rng:NextInteger(2, 6)
	for i = 1, count do
		table.insert(d.spine, { r = rng:NextNumber(0.55, 1.25), y = i == 1 and rng:NextNumber(0, 0.8) or rng:NextNumber(-0.2, 0.3) })
	end
	d.head = { id = Catalog.Heads[rng:NextInteger(1, #Catalog.Heads)].id, scale = rng:NextNumber(0.8, 1.25) }
	d.colors = { rng:NextInteger(1, 24), rng:NextInteger(1, 24), rng:NextInteger(1, 24) }
	d.pattern = Catalog.Patterns[rng:NextInteger(1, #Catalog.Patterns)]
	d.parts = {}

	local function pick(category)
		local list = Catalog.ByCategory[category]
		return list[rng:NextInteger(1, #list)].id
	end
	local function put(id, on, nrm, mirrored)
		table.insert(d.parts, { id = id, on = on, pos = { 0, 0, 0 }, nrm = nrm, s = 1, rot = 0, m = mirrored })
	end

	put(pick("Eyes"), "head", { 0.45, 0.35, -0.8 }, true)
	put(pick("Mouths"), "head", { 0, -0.3, -1 }, false)
	local leg = pick("Legs")
	put(leg, 1, { 0.8, -0.6, 0 }, true)
	put(leg, count, { 0.8, -0.6, 0 }, true)
	put(pick("Tails"), count, { 0, 0.1, 1 }, false)
	if rng:NextNumber() < 0.35 then
		put(pick("Arms"), 1, { 1, 0, -0.2 }, true)
	end
	if rng:NextNumber() < 0.2 then
		put(pick("Wings"), math.ceil(count / 2), { 0.5, 0.85, 0 }, true)
	end
	if rng:NextNumber() < 0.6 then
		put(pick("Weapons"), "head", { 0.4, 0.9, 0 }, true)
	end
	if rng:NextNumber() < 0.7 then
		put(pick("Decor"), math.ceil(count / 2), { 0, 1, 0 }, false)
	end
	return seat(d)
end

return Data
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">IK</string><ProtectedString name="Source"><![CDATA[-- Analytic two-bone inverse kinematics.
local IK = {}

-- Returns the knee/elbow position and the (reach-clamped) end position.
function IK.solve(root, target, l1, l2, pole)
	local offset = target - root
	local dist = offset.Magnitude
	local dir = dist > 1e-4 and offset / dist or Vector3.new(0, -1, 0)
	dist = math.clamp(dist, math.abs(l1 - l2) + 1e-3, l1 + l2 - 1e-3)
	local cosA = math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1)
	local sinA = math.sqrt(1 - cosA * cosA)
	local bend = pole - dir * pole:Dot(dir)
	if bend.Magnitude < 1e-4 then
		bend = dir:Cross(Vector3.new(1, 0, 0))
	end
	bend = bend.Unit
	return root + dir * (l1 * cosA) + bend * (l1 * sinA), root + dir * dist
end

-- CFrame for a bone whose length runs along its Z axis from a to b.
function IK.bone(a, b)
	local mid = (a + b) / 2
	local dir = b - a
	if dir.Magnitude < 1e-4 then
		return CFrame.new(mid)
	end
	dir = dir.Unit
	local up = math.abs(dir.Y) > 0.98 and Vector3.new(0, 0, 1) or Vector3.new(0, 1, 0)
	return CFrame.lookAt(mid, mid + dir, up)
end

return IK
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">CreatureBuilder</string><ProtectedString name="Source"><![CDATA[-- Turns creature data into a Model. Body space: front is -Z, up is +Y.
local Catalog = require(script.Parent.PartCatalog)
local IK = require(script.Parent.IK)

local Builder = {}

local SPACING = 0.9
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.fromRGB(20, 20, 25)
local BONE = Color3.fromRGB(235, 225, 200)
local MOUTH = Color3.fromRGB(120, 40, 60)

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end

-- Frame on the body surface: +Y points out of the skin, -Z points forward (or up on the face).
function Builder.surfaceFrame(pos, nrm, rotDegrees)
	local up = nrm.Magnitude > 1e-3 and nrm.Unit or Vector3.new(0, 1, 0)
	local forward = Vector3.new(0, 0, -1)
	if math.abs(up:Dot(forward)) > 0.8 then
		forward = Vector3.new(0, 1, 0)
	end
	local look = (forward - up * forward:Dot(up)).Unit
	local back = -look
	local right = up:Cross(back)
	return CFrame.fromMatrix(pos, right, up, back) * CFrame.Angles(0, math.rad(rotDegrees or 0), 0)
end

-- Spine segments and head as ellipsoids (also used for tap placement).
function Builder.ellipsoids(data)
	local list = {}
	local n = #data.spine
	for i, seg in ipairs(data.spine) do
		local z = (i - 1 - (n - 1) / 2) * SPACING
		table.insert(list, { c = Vector3.new(0, seg.y, z), r = Vector3.one * seg.r, index = i })
	end
	local headShape = Catalog.Heads[1]
	for _, h in ipairs(Catalog.Heads) do
		if h.id == data.head.id then
			headShape = h
		end
	end
	local first = list[1]
	local hs = data.head.scale
	local headRadius = headShape.size * 0.85 * hs
	local center = first.c + Vector3.new(0, 0.35, -(first.r.Z * 0.75 + headRadius.Z * 0.7))
	table.insert(list, { c = center, r = headRadius, head = true })
	return list
end

-- Nearest hit of a body-space ray against the ellipsoids.
function Builder.raycast(shapes, origin, dir)
	local bestT, bestPos, bestNormal, bestShape
	for _, e in ipairs(shapes) do
		local o = (origin - e.c) / e.r
		local d = dir / e.r
		local a = d:Dot(d)
		local b = 2 * o:Dot(d)
		local c = o:Dot(o) - 1
		local disc = b * b - 4 * a * c
		if disc >= 0 then
			local t = (-b - math.sqrt(disc)) / (2 * a)
			if t > 0 and (not bestT or t < bestT) then
				bestT = t
				bestPos = origin + dir * t
				bestNormal = ((bestPos - e.c) / (e.r * e.r)).Unit
				bestShape = e
			end
		end
	end
	return bestPos, bestNormal, bestT, bestShape
end

function Builder.build(data, opts)
	opts = opts or {}
	local s = opts.scale or 1
	local elder = opts.elder

	local model = Instance.new("Model")
	model.Name = "Creature"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic

	local function shade(color)
		if elder then
			return color:Lerp(Color3.fromRGB(170, 170, 175), 0.3)
		end
		return color
	end

	local base = shade(Catalog.Palette[data.colors[1]])
	local belly = shade(Catalog.Palette[data.colors[2]])
	local accent = shade(Catalog.Palette[data.colors[3]])
	local skin = Enum.Material[data.material]

	local joints = {} -- { part, parent, name, attributes }
	local hits = {} -- spheres used by the editor to select parts and sculpt dabs

	-- All inputs are in unscaled body space.
	local function make(cf, size, color, material, shape)
		local part = Instance.new("Part")
		part.Size = Vector3.new(
			math.max(size.X * s, 0.05),
			math.max(size.Y * s, 0.05),
			math.max(size.Z * s, 0.05)
		)
		part.CFrame = cf.Rotation + cf.Position * s
		part.Color = color
		part.Material = material or Enum.Material.SmoothPlastic
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		part.Anchored = opts.anchored == true
		part.CastShadow = size.Magnitude > 1.2
		if shape == "ball" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		end
		part.Parent = model
		return part
	end

	local function joint(part, parent, name, attributes)
		table.insert(joints, { part = part, parent = parent, name = name, attributes = attributes })
		return part
	end

	-- static decoration welded to a parent bone
	local function ball(parent, cf, size, color, material)
		return joint(make(cf, size, color, material, "ball"), parent)
	end
	local function box(parent, cf, size, color, material)
		return joint(make(cf, size, color, material), parent)
	end

	-- tapered, optionally curved cone along the frame's +Y
	local function spike(parent, cf, length, radius, color, bend, material)
		local steps = bend and math.abs(bend) > 120 and 9 or 5
		local step = length / steps
		local turn = math.rad((bend or 0) / steps)
		local current = cf
		for i = 1, steps do
			local r = radius * (1 - (i - 1) / (steps + 0.3))
			ball(parent, current * CFrame.new(0, step / 2, 0), Vector3.new(r * 2, step * 1.8, r * 2), color, material)
			current = current * CFrame.new(0, step, 0) * CFrame.Angles(turn, 0, 0)
		end
	end

	local function boneBetween(parent, a, b, width, color)
		local len = (b - a).Magnitude
		return ball(parent, IK.bone(a, b), Vector3.new(width, width, len + width), color)
	end

	local root = make(CFrame.new(), Vector3.new(1.6, 1.6, 1.6), base)
	root.Name = "HumanoidRootPart"
	root.Transparency = 1
	root.Massless = false
	root.CanCollide = not opts.anchored
	model.PrimaryPart = root

	local shapes = Builder.ellipsoids(data)
	local headShape = shapes[#shapes]

	-- head bone (rotates for biting and looking around)
	local neckPoint = headShape.c + Vector3.new(0, 0, headShape.r.Z * 0.7)
	local headBone = make(CFrame.new(neckPoint), Vector3.new(0.1, 0.1, 0.1), base)
	headBone.Transparency = 1
	joint(headBone, root, "Head", { Kind = "Head", Pivot = neckPoint * s })

	local function skinBall(parent, center, radii, color)
		return ball(parent, CFrame.new(center), radii * 2, color, skin)
	end

	-- body
	local rng = Random.new(#data.spine * 100 + data.colors[1])
	for i = 1, #data.spine do
		local e = shapes[i]
		local color = (data.pattern == "Stripes" and i % 2 == 0) and accent or base
		skinBall(root, e.c, e.r, color)
		local nextShape = shapes[i + 1]
		if i < #data.spine then
			for k = 1, 2 do
				local t = k / 3
				local c = e.c:Lerp(nextShape.c, t)
				local r = e.r:Lerp(nextShape.r, t)
				local mixed = (data.pattern == "Stripes" and k == 1) and accent or base
				skinBall(root, c, r * 0.98, mixed)
			end
		end
		if data.pattern == "Belly" then
			ball(root, CFrame.new(e.c + Vector3.new(0, -e.r.Y * 0.18, 0)), Vector3.new(1.7, 1.68, 1.7) * e.r.X, belly, skin)
		elseif data.pattern == "Spots" then
			for _ = 1, 7 do
				local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.2, 1), rng:NextNumber(-1, 1)).Unit
				local frame = Builder.surfaceFrame(e.c + dir * e.r.X * 0.97, dir)
				local d = rng:NextNumber(0.25, 0.55) * e.r.X
				ball(root, frame, Vector3.new(d, 0.14, d), accent)
			end
		end
	end
	-- neck and head
	for k = 1, 3 do
		local t = k / 4
		local c = shapes[1].c:Lerp(headShape.c, t)
		local r = math.min(shapes[1].r.X, headShape.r.X, headShape.r.Y) * 0.85
		skinBall(root, c, Vector3.one * r, base)
	end
	skinBall(headBone, headShape.c, headShape.r, base)

	-- which bone a surface point belongs to
	local function boneFor(pos)
		local q = (pos - headShape.c) / headShape.r
		return q.Magnitude < 1.35 and headBone or root
	end

	-- ground height: the longest leg decides how tall the creature stands
	local groundY = math.huge
	for i = 1, #data.spine do
		groundY = math.min(groundY, shapes[i].c.Y - shapes[i].r.Y)
	end
	for _, entry in ipairs(data.parts) do
		local def = Catalog.Parts[entry.id]
		if def.build == "leg" then
			groundY = math.min(groundY, entry.pos[2] - def.p.len * entry.s * 0.92)
		end
	end

	local limbCount, tailCount, wingCount, pairCount = 0, 0, 0, 0

	local function buildLimb(def, entry, pos, side, color, isArm)
		limbCount += 1
		local p = def.p
		local scale = entry.s
		local len = p.len * scale
		local width = p.w * scale
		local rest, pole
		if isArm then
			rest = pos + Vector3.new(side * len * 0.45, -len * 0.45, -len * 0.55)
			pole = Vector3.new(side * 0.6, -0.4, 1)
		else
			local splay = p.knee == "out" and 0.55 or 0.12
			rest = Vector3.new(pos.X + side * len * splay, groundY + width * 0.3, pos.Z)
			if p.knee == "front" then
				pole = Vector3.new(side * 0.1, 0, -1)
			elseif p.knee == "back" then
				pole = Vector3.new(side * 0.1, 0, 1)
			else
				pole = Vector3.new(side, 1.2, 0)
			end
		end
		local need = (rest - pos).Magnitude
		local l1 = math.max(len * 0.55, need * 0.53)
		local l2 = l1
		local knee, foot = IK.solve(pos, rest, l1, l2, pole)
		local limbColor = p.color and shade(p.color) or color
		local name = "Limb" .. limbCount

		local upper = make(IK.bone(pos, knee), Vector3.new(width * 1.25, width * 1.25, l1 + width * 0.6), limbColor, skin, "ball")
		joint(upper, root, name .. "_U", {
			Kind = "Limb", Limb = name, Hip = pos * s, Rest = rest * s, L1 = l1 * s, L2 = l2 * s,
			Pole = pole, Arm = isArm, Group = (pairCount + (side > 0 and 0 or 1)) % 2,
		})
		local lower = make(IK.bone(knee, foot), Vector3.new(width, width, l2 + width * 0.6), limbColor, skin, "ball")
		joint(lower, root, name .. "_L")
		local tipFrame = CFrame.new(foot)
		local tip = make(tipFrame, Vector3.new(width, width, width), limbColor, skin, "ball")
		joint(tip, root, name .. "_F")
		ball(upper, CFrame.new(pos), Vector3.one * width * 1.5, limbColor, skin)
		ball(lower, CFrame.new(knee), Vector3.one * width * 1.05, limbColor, skin)

		local w = width
		local function at(x, y, z)
			return tipFrame * CFrame.new(x * w, y * w, z * w)
		end
		local style = p.foot or p.hand
		if style == "pad" then
			ball(tip, at(0, -0.1, -0.2), Vector3.new(1.5, 0.7, 1.8) * w, limbColor)
		elseif style == "paw" then
			ball(tip, at(0, -0.1, -0.35), Vector3.new(1.6, 0.8, 2) * w, limbColor)
			for t = -1, 1 do
				ball(tip, at(t * 0.5, -0.2, -1.3), Vector3.one * 0.55 * w, belly)
			end
		elseif style == "hoof" then
			box(tip, at(0, -0.05, -0.1), Vector3.new(1.4, 0.8, 1.5) * w, BLACK)
		elseif style == "talon" then
			for _, a in ipairs({ -35, 0, 35, 180 }) do
				spike(tip, tipFrame * CFrame.Angles(0, math.rad(a), 0) * CFrame.Angles(math.rad(-95), 0, 0), w * 2.4, w * 0.35, limbColor, -20)
			end
		elseif style == "point" then
			spike(tip, tipFrame * CFrame.Angles(math.pi, 0, 0), w * 1.2, w * 0.4, BLACK)
		elseif style == "web" then
			ball(tip, at(0, -0.15, -1), Vector3.new(2.6, 0.25, 2.2) * w, belly)
			for t = -1, 1 do
				boneBetween(tip, foot, foot + Vector3.new(t * w * 1.1, -w * 0.15, -w * 2), w * 0.35, limbColor)
			end
		elseif style == "fingers" then
			for t = -1, 1 do
				boneBetween(tip, foot, foot + Vector3.new(t * w * 0.8, -w * 0.5, -w * 1.6), w * 0.4, limbColor)
			end
		elseif style == "claws" then
			for t = -1, 1 do
				spike(tip, at(t * 0.55, 0, -0.3) * CFrame.Angles(math.rad(-80), 0, 0), w * 2.4, w * 0.3, BONE, -70)
			end
		elseif style == "pincer" then
			ball(tip, at(0, 0, -0.5), Vector3.new(1.8, 1.4, 2) * w, accent)
			spike(tip, at(0.6, 0, -1.1) * CFrame.Angles(math.rad(-90), 0, math.rad(-20)), w * 2.6, w * 0.5, accent, 0)
			spike(tip, at(-0.6, 0, -1.1) * CFrame.Angles(math.rad(-90), 0, math.rad(20)), w * 2.6, w * 0.5, accent, 0)
		elseif style == "blade" then
			spike(tip, tipFrame * CFrame.Angles(math.rad(-55), 0, 0), w * 7, w * 0.7, BONE, -40, Enum.Material.Metal)
		elseif style == "paddle" then
			ball(tip, at(0, 0, -1) * CFrame.Angles(math.rad(-20), 0, 0), Vector3.new(2.6, 0.5, 3.6) * w, accent)
		elseif style == "fist" then
			ball(tip, at(0, 0, -0.5), Vector3.one * 2.6 * w, accent)
		end
	end

	local function buildTail(def, entry, pos, nrm, color)
		tailCount += 1
		local p = def.p
		local count = 6
		local len = p.len * entry.s
		local width = p.w * entry.s
		local dir = Vector3.new(nrm.X, nrm.Y * 0.5, math.max(nrm.Z, 0.4)).Unit
		local current = pos
		local last
		for i = 1, count do
			local lift = p.curl and (i - 1) * 0.35 or -0.07 * (i - 1)
			local step = (dir + Vector3.new(0, lift, p.curl and -(i - 1) * 0.17 or 0)).Unit * (len / count)
			local nextPoint = current + step
			local w = width * (1 - (i - 1) / (count + 1))
			local seg = make(IK.bone(current, nextPoint), Vector3.new(w, w, len / count + w), color, skin, "ball")
			joint(seg, root, "Tail" .. tailCount .. "_" .. i, { Kind = "Tail", Index = i, Pivot = pos * s })
			last = seg
			current = nextPoint
		end
		local tip = CFrame.new(current)
		local w = width
		if p.tip == "spikes" then
			for _, a in ipairs({ -80, -30, 30, 80 }) do
				spike(last, tip * CFrame.Angles(math.rad(40), 0, math.rad(a)), w * 1.8, w * 0.2, BONE)
			end
		elseif p.tip == "club" then
			ball(last, tip, Vector3.one * w * 1.8, accent, skin)
			for _, a in ipairs({ -90, 0, 90 }) do
				spike(last, tip * CFrame.Angles(0, 0, math.rad(a)) * CFrame.new(0, w * 0.7, 0), w, w * 0.25, BONE)
			end
		elseif p.tip == "fan" then
			for a = -2, 2 do
				local f = tip * CFrame.Angles(math.rad(a * 28), 0, 0)
				ball(last, f * CFrame.new(0, 0, w), Vector3.new(w * 0.15, w * 0.8, w * 2.4), accent)
			end
		elseif p.tip == "sting" then
			ball(last, tip, Vector3.one * w * 1.3, accent)
			spike(last, tip * CFrame.Angles(math.rad(-110), 0, 0), w * 2.5, w * 0.35, BLACK, -50)
		elseif p.tip == "fluff" then
			for i = 1, 8 do
				local a = i * 2.4
				ball(last, tip * CFrame.new(math.cos(a) * w * 0.4, math.sin(a) * w * 0.4, (i % 3) * w * 0.25), Vector3.one * w, accent, Enum.Material.Fabric)
			end
		elseif p.tip == "rattle" then
			for i = 0, 3 do
				ball(last, tip * CFrame.new(0, 0, i * w * 0.5), Vector3.new(1, 1, 0.55) * w * (1.2 - i * 0.2), BONE)
			end
		end
	end

	local function buildWing(def, entry, pos, side, color)
		wingCount += 1
		local span = def.p.span * entry.s
		local style = def.p.style
		local wingBone = make(CFrame.new(pos), Vector3.new(0.1, 0.1, 0.1), color)
		wingBone.Transparency = 1
		joint(wingBone, root, "Wing" .. wingCount, { Kind = "Wing", Side = side, Pivot = pos * s })
		local elbow = pos + Vector3.new(side * span * 0.55, span * 0.4, 0)
		local tip = pos + Vector3.new(side * span * 1.25, span * 0.3, span * 0.2)
		if style == "bug" then
			for i = 0, 1 do
				local f = CFrame.new(pos) * CFrame.Angles(0, math.rad(side * (-15 - i * 35)), math.rad(side * 20))
				local part = ball(wingBone, f * CFrame.new(side * span * 0.65, 0, 0), Vector3.new(span * 1.3, 0.07, span * 0.45), Color3.fromRGB(200, 235, 255), Enum.Material.Glass)
				part.Transparency = 0.35
			end
			return
		end
		boneBetween(wingBone, pos, elbow, span * 0.14, color)
		boneBetween(wingBone, elbow, tip, span * 0.1, color)
		for i = 0, 5 do
			local t = i / 5
			local a = t < 0.5 and pos:Lerp(elbow, t * 2) or elbow:Lerp(tip, t * 2 - 1)
			local drop = Vector3.new(side * span * 0.15 * t, -span * 0.15, span * (0.55 + 0.25 * math.sin(t * math.pi)))
			if style == "feather" then
				ball(wingBone, IK.bone(a, a + drop), Vector3.new(span * 0.28, 0.08, drop.Magnitude), i % 2 == 0 and accent or color)
			else
				boneBetween(wingBone, a, a + drop, span * 0.05, color)
				ball(wingBone, IK.bone(a, a + drop * 0.85), Vector3.new(span * 0.36, 0.05, drop.Magnitude * 0.85), accent)
			end
		end
	end

	local function buildDetail(def, entry, pos, nrm, side, color)
		local frame = Builder.surfaceFrame(pos, nrm, entry.rot * side)
		local parent = boneFor(pos)
		local k = entry.s
		local p = def.p
		local kind = def.build
		local function at(x, y, z)
			return frame * CFrame.new(x * k, y * k, z * k)
		end
		local function e(cf, x, y, z, c, material)
			return ball(parent, cf, Vector3.new(x, y, z) * k, c, material)
		end
		local function cone(cf, length, radius, c, bend, material)
			spike(parent, cf, length * k, radius * k, c, bend, material)
		end
		local function pointAt(x, y, z)
			return at(x, y, z).Position
		end
		local function line(a, b, width, c)
			boneBetween(parent, a, b, width * k, c)
		end
		local tint = p.color and not entry.c and shade(p.color) or color

		if kind == "eye" then
			local r = p.r
			local lift = p.stalk or 0
			if lift > 0 then
				line(frame.Position, pointAt(0, lift, 0), 0.14, color)
			end
			local c = lift + r * 0.35
			e(at(0, c, 0), r * 2, r * 2, r * 2, p.iris or WHITE, p.glow and Enum.Material.Neon or nil)
			local pupil = (p.pupil or 0.5) * r
			if p.slit then
				e(at(0, c + r * 0.92, 0), r * 0.28, r * 0.3, r * 1.4, BLACK)
			else
				e(at(0, c + r * 0.82, 0), pupil * 1.7, r * 0.5, pupil * 1.7, BLACK)
			end
			if p.shine then
				e(at(r * 0.25, c + r * 1.05, -r * 0.25), r * 0.4, r * 0.2, r * 0.4, WHITE, Enum.Material.Neon)
			end
			if p.lid then
				e(at(0, c + r * 0.25, -r * 0.45), r * 2.2, r * 1.9, r * 1.3, color)
			end
		elseif kind == "compound" then
			e(at(0, 0.1, 0), 0.7, 0.55, 0.7, BLACK, Enum.Material.Glass)
			for i = 0, 6 do
				local a = i * math.pi / 3
				local r = i == 6 and 0 or 0.2
				e(at(math.cos(a) * r, 0.36 - r * 0.3, math.sin(a) * r), 0.16, 0.1, 0.16, accent)
			end
		elseif kind == "lips" then
			e(at(0, 0.02, 0), 0.75, 0.2, 0.34, MOUTH)
			e(at(0, 0.1, -0.12), 0.85, 0.22, 0.2, accent)
			e(at(0, 0.1, 0.14), 0.75, 0.22, 0.2, accent)
		elseif kind == "beak" then
			cone(at(0, -0.05, -0.08), p.len, p.w * 0.5, tint, p.hook and -80 or -10)
			cone(at(0, -0.05, 0.18), p.len * 0.6, p.w * 0.35, tint, 15)
		elseif kind == "jaws" then
			e(at(0, 0.05, 0), 1.0, 0.25, 0.6, MOUTH)
			e(at(0, p.len * 0.45, -0.25), 0.95, p.len, 0.28, color)
			e(at(0, p.len * 0.4, 0.32), 0.85, p.len * 0.9, 0.25, belly)
			for i = 1, p.teeth do
				local x = (i - 0.5) / p.teeth * 0.8 - 0.4
				local long = p.fang and (i == 1 or i == p.teeth)
				cone(at(x, p.len * 0.75, -0.14) * CFrame.Angles(math.rad(90), 0, 0), long and 0.4 or 0.2, 0.07, BONE)
				cone(at(x, p.len * 0.65, 0.2) * CFrame.Angles(math.rad(-90), 0, 0), 0.17, 0.06, BONE)
			end
		elseif kind == "snout" then
			e(at(0, 0.25, 0), 0.65, 0.65, 0.55, color)
			e(at(0, 0.55, 0), 0.5, 0.15, 0.42, accent)
			e(at(0.13, 0.63, 0), 0.12, 0.06, 0.16, BLACK)
			e(at(-0.13, 0.63, 0), 0.12, 0.06, 0.16, BLACK)
		elseif kind == "probe" then
			cone(at(0, 0, 0), 1.8, 0.2, accent, 70)
		elseif kind == "mandible" then
			e(at(0, 0, 0), 0.5, 0.2, 0.4, MOUTH)
			cone(at(0.3, 0, 0) * CFrame.Angles(0, 0, math.rad(-20)) * CFrame.Angles(0, math.rad(90), 0), 0.9, 0.15, BLACK, -55)
			cone(at(-0.3, 0, 0) * CFrame.Angles(0, 0, math.rad(20)) * CFrame.Angles(0, math.rad(-90), 0), 0.9, 0.15, BLACK, -55)
		elseif kind == "bill" then
			e(at(0, 0.45, -0.05), 0.8, 0.9, 0.2, Color3.fromRGB(240, 165, 45))
			e(at(0, 0.35, 0.17), 0.65, 0.7, 0.17, Color3.fromRGB(215, 135, 35))
		elseif kind == "spike" then
			cone(frame, p.len, p.r, entry.c and color or BONE, p.bend)
		elseif kind == "antler" then
			local a = pointAt(0, 0.7, 0.1)
			local b = pointAt(0, 1.4, 0.35)
			local c = entry.c and color or BONE
			line(frame.Position, a, 0.2, c)
			line(a, b, 0.15, c)
			line(a, pointAt(0.35, 1.1, -0.35), 0.12, c)
			line(b, pointAt(0.45, 1.8, 0.2), 0.1, c)
			line(b, pointAt(-0.25, 1.9, 0.5), 0.1, c)
		elseif kind == "row" then
			for i = -2, 2 do
				cone(at(0, -math.abs(i) * 0.07, i * 0.4), 0.75 - math.abs(i) * 0.14, 0.16, entry.c and color or BONE, 20)
			end
		elseif kind == "plate" then
			e(at(0, 0.05, 0), 1.2, 0.35, 1.4, entry.c and color or accent, Enum.Material.Slate)
		elseif kind == "shell" then
			e(at(0, 0.05, 0), 2.2, 1.3, 2.6, entry.c and color or accent, Enum.Material.Slate)
			e(at(0, 0, 0), 2.45, 0.35, 2.85, BONE)
			for i = -1, 1 do
				e(at(0, 0.62 - math.abs(i) * 0.12, i * 0.7), 0.75, 0.25, 0.55, belly, Enum.Material.Slate)
			end
		elseif kind == "ear" then
			local h = p.h
			if p.floppy then
				e(at(0.1 * side, 0.25, h * 0.35), p.w, 0.2, h, color)
			else
				e(at(0, h * 0.4, 0), p.w, h, 0.18, color)
				e(at(0, h * 0.4, -0.08), p.w * 0.6, h * 0.7, 0.1, belly)
			end
		elseif kind == "tuft" then
			for i = -2, 2 do
				local f = frame * CFrame.Angles(math.rad(-15), 0, math.rad(i * 20))
				ball(parent, f * CFrame.new(0, 0.55 * k, 0), Vector3.new(0.22, 1.1 - math.abs(i) * 0.15, 0.08) * k, i % 2 == 0 and accent or color)
			end
		elseif kind == "sail" then
			for i = -3, 3 do
				local h = 1.1 - i * i * 0.08
				e(at(0, h * 0.4, i * 0.3), 0.12, h, 0.4, accent)
				cone(at(0, 0, i * 0.3), h * 0.95, 0.07, color)
			end
		elseif kind == "frill" then
			for i = -4, 4 do
				local f = frame * CFrame.Angles(0, 0, math.rad(i * 24))
				ball(parent, f * CFrame.new(0, 0.55 * k, 0), Vector3.new(0.5, 1.15, 0.1) * k, i % 2 == 0 and accent or color)
			end
		elseif kind == "antenna" then
			local a = pointAt(0, 0.7, -0.1)
			local b = pointAt(0, 1.3, -0.55)
			line(frame.Position, a, 0.08, color)
			line(a, b, 0.07, color)
			e(CFrame.new(b), 0.28, 0.28, 0.28, accent)
		elseif kind == "whisker" then
			for i = -1, 1 do
				line(frame.Position, pointAt(1.1, 0.35, i * 0.35), 0.04, BONE)
				line(frame.Position, pointAt(-1.1, 0.35, i * 0.35), 0.04, BONE)
			end
		elseif kind == "puff" then
			for i = 0, 6 do
				local a = i * math.pi / 3
				local r = i == 6 and 0 or 0.3
				e(at(math.cos(a) * r, i == 6 and 0.3 or 0.1, math.sin(a) * r), 0.5, 0.5, 0.5, color, Enum.Material.Fabric)
			end
		elseif kind == "orb" then
			line(frame.Position, pointAt(0, 0.7, 0), 0.07, color)
			local orb = e(at(0, 0.85, 0), 0.42, 0.42, 0.42, accent, Enum.Material.Neon)
			local light = Instance.new("PointLight")
			light.Color = accent
			light.Range = 8
			light.Parent = orb
		elseif kind == "flower" then
			for i = 1, 6 do
				local f = frame * CFrame.Angles(0, i * math.pi / 3, 0)
				ball(parent, f * CFrame.new(0, 0.12 * k, -0.3 * k), Vector3.new(0.34, 0.1, 0.5) * k, accent)
			end
			e(at(0, 0.18, 0), 0.32, 0.2, 0.32, Color3.fromRGB(255, 215, 60))
		elseif kind == "shroom" then
			line(frame.Position, pointAt(0, 0.55, 0), 0.18, BONE)
			e(at(0, 0.62, 0), 0.8, 0.45, 0.8, accent)
			e(at(0.2, 0.83, 0.1), 0.16, 0.08, 0.16, WHITE)
			e(at(-0.16, 0.82, -0.18), 0.13, 0.08, 0.13, WHITE)
		elseif kind == "crystal" then
			for i, tilt in ipairs({ 0, 32, -35 }) do
				local h = (i == 1 and 1.1 or 0.7) * k
				local f = frame * CFrame.Angles(math.rad(tilt * 0.5), 0, math.rad(tilt))
				local gem = box(parent, f * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, math.rad(45), 0), Vector3.new(0.24 * k, h, 0.24 * k), accent, Enum.Material.Glass)
				gem.Transparency = 0.2
			end
		elseif kind == "gill" then
			for i = -1, 1 do
				e(at(0, 0.02, i * 0.25), 0.7, 0.1, 0.09, MOUTH)
			end
		elseif kind == "nostril" then
			e(at(0, 0.03, 0), 0.22, 0.12, 0.22, color)
			e(at(0, 0.09, 0), 0.11, 0.07, 0.11, BLACK)
		end
	end

	-- attach parts
	for index, entry in ipairs(data.parts) do
		local def = Catalog.Parts[entry.id]
		local color = entry.c and shade(Catalog.Palette[entry.c]) or base
		local sides = entry.m and { 1, -1 } or { 1 }
		for _, mirrorSign in ipairs(sides) do
			local pos = v3(entry.pos) * Vector3.new(mirrorSign, 1, 1)
			local nrm = v3(entry.nrm) * Vector3.new(mirrorSign, 1, 1)
			local side = pos.X < -0.01 and -1 or 1
			table.insert(hits, { c = pos, r = 0.45 * entry.s, part = index })
			if def.build == "leg" then
				if mirrorSign == 1 then
					pairCount += 1
				end
				buildLimb(def, entry, pos, side, color, false)
			elseif def.build == "arm" then
				buildLimb(def, entry, pos, side, color, true)
			elseif def.build == "tail" then
				buildTail(def, entry, pos, nrm, color)
			elseif def.build == "wing" then
				buildWing(def, entry, pos, side, color)
			else
				buildDetail(def, entry, pos, nrm, side, color)
			end
		end
	end

	-- sculpted details
	for index, dab in ipairs(data.sculpt) do
		local color = shade(Catalog.Palette[dab.c])
		local sides = dab.m and { 1, -1 } or { 1 }
		for _, mirrorSign in ipairs(sides) do
			local pos = v3(dab.pos) * Vector3.new(mirrorSign, 1, 1)
			local nrm = v3(dab.nrm) * Vector3.new(mirrorSign, 1, 1)
			local frame = Builder.surfaceFrame(pos, nrm)
			local parent = boneFor(pos)
			local k = dab.s
			table.insert(hits, { c = pos, r = k * 0.6, dab = index })
			if dab.b == "Blob" then
				ball(parent, frame, Vector3.one * k, color, skin)
			elseif dab.b == "Spike" then
				spike(parent, frame, k * 1.8, k * 0.35, color)
			elseif dab.b == "Ridge" then
				ball(parent, frame, Vector3.new(k * 0.4, k * 0.7, k * 1.7), color, skin)
			elseif dab.b == "Plate" then
				ball(parent, frame, Vector3.new(k * 1.5, k * 0.3, k * 1.5), color, skin)
			elseif dab.b == "Wart" then
				ball(parent, frame, Vector3.one * k * 0.55, color, skin)
				ball(parent, frame * CFrame.new(0, k * 0.3, 0), Vector3.one * k * 0.2, color:Lerp(BLACK, 0.4))
			elseif dab.b == "Strand" then
				spike(parent, frame, k * 2.4, k * 0.12, color, 90)
			elseif dab.b == "Gem" then
				ball(parent, frame * CFrame.new(0, k * 0.1, 0), Vector3.new(k * 0.6, k * 0.45, k * 0.6), color, Enum.Material.Neon)
			end
		end
	end

	if not opts.anchored then
		for _, j in ipairs(joints) do
			local link = Instance.new(j.name and "Motor6D" or "Weld")
			link.Name = j.name or "W"
			link.Part0 = j.parent
			link.Part1 = j.part
			link.C0 = j.parent.CFrame:ToObjectSpace(j.part.CFrame)
			if j.attributes then
				for key, value in pairs(j.attributes) do
					link:SetAttribute(key, value)
				end
			end
			-- animated joints live in the root so the animator can find them quickly
			link.Parent = j.name and root or j.part
		end
	end

	local ground = groundY * s -- negative: distance from root centre down to the feet
	root.Size = Vector3.new(1.6, 1.2, 2) * math.max(s, 0.4)
	model:SetAttribute("Ground", ground)
	model:SetAttribute("Scale", s)

	return model, { shapes = shapes, hits = hits, ground = ground }
end

-- Adds a Humanoid so the creature can walk (players and NPCs).
function Builder.addHumanoid(model, stats)
	local root = model.PrimaryPart
	local scale = model:GetAttribute("Scale")
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.AutomaticScalingEnabled = false
	humanoid.HipHeight = math.max(-model:GetAttribute("Ground") - root.Size.Y / 2, 0.1)
	humanoid.MaxHealth = stats.health
	humanoid.Health = stats.health
	humanoid.WalkSpeed = stats.speed * (0.6 + 0.4 * scale)
	humanoid.UseJumpPower = true
	humanoid.JumpPower = stats.jump
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	humanoid.Parent = model
	return humanoid
end

return Builder
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX17"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX16"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local TextService = game:GetService("TextService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Data = require(Shared.CreatureData)
local Builder = require(Shared.CreatureBuilder)

Players.CharacterAutoLoads = false

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(class, name)
	local r = Instance.new(class)
	r.Name = name
	r.Parent = remotes
	return r
end
local getProfile = remote("RemoteFunction", "GetProfile")
local saveCreature = remote("RemoteFunction", "SaveCreature")
local play = remote("RemoteEvent", "Play")
local toMenu = remote("RemoteEvent", "ToMenu")
local bite = remote("RemoteEvent", "Bite")
local sprint = remote("RemoteEvent", "Sprint")
local notify = remote("RemoteEvent", "Notify")
local editing = remote("RemoteEvent", "Editing")
remotes.Parent = ReplicatedStorage

----------------------------------------------------------------------------
-- World
----------------------------------------------------------------------------
local rng = Random.new(7)
local NEST = Vector3.new(0, 0, 0)

local worldFolder = Instance.new("Folder")
worldFolder.Name = "World"
worldFolder.Parent = workspace
local foodFolder = Instance.new("Folder")
foodFolder.Name = "Food"
foodFolder.Parent = workspace
local npcFolder = Instance.new("Folder")
npcFolder.Name = "Wildlife"
npcFolder.Parent = workspace

local function prop(parent, size, cf, color, material, shape)
	local p = Instance.new("Part")
	p.Anchored = true
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

local function randomPoint(minRadius, maxRadius)
	local a = rng:NextNumber(0, math.pi * 2)
	local r = rng:NextNumber(minRadius, maxRadius)
	return Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
end

local menuCamera = workspace:FindFirstChild("MenuCamera")
if not menuCamera then
	menuCamera = prop(workspace, Vector3.new(2, 2, 2), CFrame.lookAt(Vector3.new(0, 7, -150), Vector3.new(0, 3, -130)), Color3.new(1, 0.5, 0))
	menuCamera.Name = "MenuCamera"
end
menuCamera.Anchored = true
menuCamera.Transparency = 1
menuCamera.CanCollide = false
menuCamera.CanQuery = false
ReplicatedStorage:SetAttribute("MenuCFrame", menuCamera.CFrame)

local function buildWorld()
	local terrain = workspace.Terrain
	local size = Config.WorldRadius * 2 + 120
	terrain:FillBlock(CFrame.new(0, -8, 0), Vector3.new(size, 16, size), Enum.Material.Grass)
	-- pond
	terrain:FillBall(Vector3.new(70, 6, 50), 18, Enum.Material.Air)
	terrain:FillCylinder(CFrame.new(70, -6, 50), 8, 18, Enum.Material.Water)
	-- hills around the edge
	for i = 1, 36 do
		local a = i / 36 * math.pi * 2
		local r = Config.WorldRadius + 35
		terrain:FillBall(Vector3.new(math.cos(a) * r, -6, math.sin(a) * r), rng:NextNumber(28, 44), i % 3 == 0 and Enum.Material.Rock or Enum.Material.LeafyGrass)
	end
	for _ = 1, 70 do
		local p = randomPoint(25, Config.WorldRadius)
		if (p - menuCamera.Position * Vector3.new(1, 0, 1)).Magnitude > 40 then
			local h = rng:NextNumber(8, 16)
			prop(worldFolder, Vector3.new(h, 1.8, 1.8), CFrame.new(p + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(110, 75, 50), Enum.Material.Wood, Enum.PartType.Cylinder)
			for _ = 1, 3 do
				local d = rng:NextNumber(5, 9)
				local leaf = prop(worldFolder, Vector3.new(d, d, d), CFrame.new(p + Vector3.new(rng:NextNumber(-2, 2), h + rng:NextNumber(-1, 2), rng:NextNumber(-2, 2))), Color3.fromHSV(rng:NextNumber(0.22, 0.42), 0.65, 0.7), Enum.Material.Grass, Enum.PartType.Ball)
				leaf.CanCollide = false
			end
		end
	end
	-- nest
	for i = 1, 20 do
		local a = i / 20 * math.pi * 2
		local twig = prop(worldFolder, Vector3.new(4, 0.8, 0.8), CFrame.new(math.cos(a) * 9, 0.4, math.sin(a) * 9) * CFrame.Angles(0, -a + math.pi / 2 + rng:NextNumber(-0.4, 0.4), 0), Color3.fromRGB(150, 110, 65), Enum.Material.Wood)
		twig.CanCollide = false
	end
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.5
	Lighting.OutdoorAmbient = Color3.fromRGB(130, 140, 160)
end

----------------------------------------------------------------------------
-- Food
----------------------------------------------------------------------------
local function addFood(kind, position, xp)
	local model = Instance.new("Model")
	model.Name = kind
	local main
	if kind == "Plant" then
		main = prop(model, Vector3.new(2.2, 2.2, 2.2), CFrame.new(position + Vector3.new(0, 0.9, 0)), Color3.fromRGB(60, 140, 60), Enum.Material.Grass, Enum.PartType.Ball)
		for i = 1, 5 do
			local a = i * 1.26
			prop(model, Vector3.new(0.55, 0.55, 0.55), CFrame.new(main.Position + Vector3.new(math.cos(a), 0.35, math.sin(a))), Color3.fromRGB(230, 60, 90), nil, Enum.PartType.Ball)
		end
	else
		main = prop(model, Vector3.new(1.8, 1, 1.4), CFrame.new(position + Vector3.new(0, 0.6, 0)), Color3.fromRGB(190, 70, 70))
		prop(model, Vector3.new(2.8, 0.4, 0.4), main.CFrame, Color3.fromRGB(240, 230, 210), nil, Enum.PartType.Cylinder)
	end
	for _, d in ipairs(model:GetChildren()) do
		d.CanCollide = false
	end
	model.PrimaryPart = main
	if kind == "Meat" then
		game:GetService("Debris"):AddItem(model, 90)
	end
	model:SetAttribute("Xp", xp)
	model.Parent = foodFolder
	return model
end

local function spawnPlant()
	addFood("Plant", randomPoint(12, Config.WorldRadius - 10), 12)
end

----------------------------------------------------------------------------
-- Player profiles
----------------------------------------------------------------------------
local store
pcall(function()
	store = DataStoreService:GetDataStore("CreatureSave_v1")
end)

local profiles = {}

local function filterName(player, name)
	local ok, result = pcall(function()
		return TextService:FilterStringAsync(name, player.UserId):GetNonChatStringForBroadcastAsync()
	end)
	if ok then
		return result
	end
	return "Creature"
end

local function loadProfile(player)
	local saved
	local loaded = false
	if store then
		loaded = pcall(function()
			saved = store:GetAsync("u" .. player.UserId)
		end)
	end
	local profile = {
		xp = type(saved) == "table" and tonumber(saved.xp) or 0,
		data = Data.sanitize(type(saved) == "table" and saved.data or nil),
		canSave = loaded, -- never overwrite a save we failed to read
		lastBite = 0,
		lastSave = 0,
	}
	profile.displayName = filterName(player, profile.data.name)
	profiles[player] = profile
	player.ReplicationFocus = menuCamera
	player:SetAttribute("Xp", profile.xp)
	player:SetAttribute("Stage", Config.stageForXp(profile.xp))
end

local function persist(player)
	local profile = profiles[player]
	if not (store and profile and profile.canSave) then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync("u" .. player.UserId, { xp = profile.xp, data = profile.data })
	end)
	if not ok then
		warn("Save failed: " .. tostring(err))
	end
end

local function spawnCreature(player, keepPosition)
	local profile = profiles[player]
	if not profile then
		return
	end
	local stage = Config.stageForXp(profile.xp)
	local stats = Data.stats(profile.data, stage)
	local old = player.Character
	local at = NEST + Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6))
	local facing = CFrame.new()
	if keepPosition and old and old.PrimaryPart then
		at = old.PrimaryPart.Position * Vector3.new(1, 0, 1)
		facing = old.PrimaryPart.CFrame.Rotation
	end

	local model = Builder.build(profile.data, { scale = Config.Stages[stage].scale, elder = stage == #Config.Stages })
	model.Name = player.Name
	local humanoid = Builder.addHumanoid(model, stats)
	humanoid.DisplayName = profile.displayName .. " (" .. Config.Stages[stage].name .. ")"
	local height = -model:GetAttribute("Ground") + 1
	model:PivotTo(CFrame.new(at + Vector3.new(0, height, 0)) * facing)
	model:SetAttribute("Speed", humanoid.WalkSpeed)
	CollectionService:AddTag(model, "Creature")

	player.ReplicationFocus = nil
	player.Character = model
	model.Parent = workspace
	if old then
		old:Destroy()
	end
	pcall(function()
		model.PrimaryPart:SetNetworkOwner(player)
	end)

	humanoid.Died:Connect(function()
		-- lose some progress but never drop a growth stage
		local floorXp = Config.Stages[Config.stageForXp(profile.xp)].xp
		profile.xp = math.max(floorXp, math.floor(profile.xp * 0.9))
		player:SetAttribute("Xp", profile.xp)
		notify:FireClient(player, "You fainted! Returning to the nest...")
		task.wait(3)
		if player.Parent and player.Character == model then
			spawnCreature(player)
		end
	end)
end

local function addXp(player, amount)
	local profile = profiles[player]
	local before = Config.stageForXp(profile.xp)
	profile.xp += amount
	local after = Config.stageForXp(profile.xp)
	player:SetAttribute("Xp", profile.xp)
	player:SetAttribute("Stage", after)
	if after > before then
		notify:FireClient(player, "You grew into " .. Config.Stages[after].name .. "! More DNA unlocked.")
		spawnCreature(player, true)
		task.spawn(persist, player)
	end
end

getProfile.OnServerInvoke = function(player)
	while player.Parent and not profiles[player] do
		task.wait(0.1)
	end
	local profile = profiles[player]
	if not profile then
		return nil
	end
	return { xp = profile.xp, data = profile.data }
end

saveCreature.OnServerInvoke = function(player, raw)
	local profile = profiles[player]
	if not profile or os.clock() - profile.lastSave < 2 then
		return false, "Please wait a moment."
	end
	profile.lastSave = os.clock()
	local data = Data.sanitize(raw)
	if not Data.fits(data, Config.stageForXp(profile.xp)) then
		return false, "Not enough DNA for this stage."
	end
	local displayName = filterName(player, data.name)
	profile.data = data
	profile.displayName = displayName
	if player.Character then
		local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
		local fraction = humanoid and humanoid.Health / humanoid.MaxHealth or 1
		if fraction > 0 then
			spawnCreature(player, true)
			local new = player.Character:FindFirstChildOfClass("Humanoid")
			new.Health = new.MaxHealth * fraction -- editing is not a free heal
		end
	end
	task.spawn(persist, player)
	return true
end

play.OnServerEvent:Connect(function(player)
	if profiles[player] and not player.Character then
		spawnCreature(player)
	end
end)

toMenu.OnServerEvent:Connect(function(player)
	if player.Character then
		player.Character:Destroy()
		player.Character = nil
	end
	player.ReplicationFocus = menuCamera
	task.spawn(persist, player)
end)

-- while the creator is open the creature is frozen and protected
editing.OnServerEvent:Connect(function(player, on)
	local model = player.Character
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local shield = model:FindFirstChild("EditShield")
	if on == true and not shield then
		shield = Instance.new("ForceField")
		shield.Name = "EditShield"
		shield.Visible = false
		shield.Parent = model
		model:SetAttribute("Jump", humanoid.JumpPower)
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
	elseif on ~= true and shield then
		shield:Destroy()
		humanoid.WalkSpeed = model:GetAttribute("Speed")
		humanoid.JumpPower = model:GetAttribute("Jump")
	end
end)

sprint.OnServerEvent:Connect(function(player, on)
	local model = player.Character
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	if humanoid and not model:FindFirstChild("EditShield") then
		humanoid.WalkSpeed = model:GetAttribute("Speed") * (on == true and 1.4 or 1)
	end
end)

----------------------------------------------------------------------------
-- Wildlife
----------------------------------------------------------------------------
local npcs = {}

local function spawnNpc()
	local data = Data.sanitize(Data.random(rng))
	local stage = rng:NextInteger(1, 4)
	local stats = Data.stats(data, stage)
	local model = Builder.build(data, { scale = Config.Stages[stage].scale })
	local aggressive = stats.meat and not stats.plant
	model.Name = aggressive and "Predator" or "Critter"
	local humanoid = Builder.addHumanoid(model, stats)
	humanoid.DisplayName = model.Name .. " Lv." .. stage
	humanoid.WalkSpeed *= 0.55
	local position = randomPoint(60, Config.WorldRadius - 15)
	model:PivotTo(CFrame.new(position + Vector3.new(0, -model:GetAttribute("Ground") + 1, 0)))
	CollectionService:AddTag(model, "Creature")
	model.Parent = npcFolder
	pcall(function()
		model.PrimaryPart:SetNetworkOwner(nil)
	end)

	local npc = { model = model, humanoid = humanoid, stage = stage, stats = stats, aggressive = aggressive, nextThink = 0, lastBite = 0 }
	npcs[model] = npc

	humanoid.Died:Connect(function()
		npcs[model] = nil
		local where = model.PrimaryPart.Position * Vector3.new(1, 0, 1)
		for i = 1, math.min(stage, 3) do
			addFood("Meat", where + Vector3.new(i * 2 - 3, 0, 0), 20 + stage * 5)
		end
		if npc.attacker and profiles[npc.attacker] then
			addXp(npc.attacker, 15 * stage)
		end
		task.wait(2)
		model:Destroy()
		task.wait(10)
		spawnNpc()
	end)
end

local function nearestPlayer(position, range)
	local best, bestDist = nil, range
	for _, player in ipairs(Players:GetPlayers()) do
		local model = player.Character
		local humanoid = model and model:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 and model.PrimaryPart then
			local dist = (model.PrimaryPart.Position - position).Magnitude
			if dist < bestDist then
				best, bestDist = player, dist
			end
		end
	end
	return best, bestDist
end

local function think(npc, now)
	local root = npc.model.PrimaryPart
	if not root then
		return
	end
	local position = root.Position
	local target
	if npc.attacker and npc.attacker.Character and npc.attacker.Character.PrimaryPart and now < (npc.angryUntil or 0) then
		target = npc.attacker
	elseif npc.aggressive then
		local player = nearestPlayer(position, 30)
		-- hatchlings are left alone
		if player and (player:GetAttribute("Stage") or 1) > 1 then
			target = player
		end
	end

	if target and target.Character and target.Character.PrimaryPart then
		local other = target.Character.PrimaryPart.Position
		if (other * Vector3.new(1, 0, 1)).Magnitude > Config.WorldRadius then
			return
		end
		local fights = npc.aggressive or npc.stats.attack >= 8
		if fights then
			npc.humanoid:MoveTo(other)
			local reach = 4 + 3 * Config.Stages[npc.stage].scale
			if (other - position).Magnitude < reach and now - npc.lastBite > 1.5 then
				npc.lastBite = now
				local humanoid = target.Character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid:TakeDamage(3 + npc.stage * 3)
					npc.model:SetAttribute("Bite", now)
				end
			end
		else
			local away = (position - other) * Vector3.new(1, 0, 1)
			if away.Magnitude > 0.1 then
				local goal = position + away.Unit * 25
				if goal.Magnitude > Config.WorldRadius then
					goal = randomPoint(0, Config.WorldRadius / 2)
				end
				npc.humanoid:MoveTo(goal)
			end
		end
	elseif now > (npc.nextWander or 0) then
		npc.nextWander = now + rng:NextNumber(3, 8)
		local goal = position + randomPoint(8, 30)
		if goal.Magnitude > Config.WorldRadius - 10 then
			goal = randomPoint(0, Config.WorldRadius / 2)
		end
		npc.humanoid:MoveTo(goal)
	end
end

----------------------------------------------------------------------------
-- Biting and eating
----------------------------------------------------------------------------
bite.OnServerEvent:Connect(function(player)
	local profile = profiles[player]
	local model = player.Character
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	if not (profile and humanoid and humanoid.Health > 0 and model.PrimaryPart) or model:FindFirstChild("EditShield") then
		return
	end
	local now = os.clock()
	if now - profile.lastBite < 0.6 then
		return
	end
	profile.lastBite = now
	model:SetAttribute("Bite", now)

	local stage = Config.stageForXp(profile.xp)
	local stats = Data.stats(profile.data, stage)
	local position = model.PrimaryPart.Position
	local reach = 5 + 4 * Config.Stages[stage].scale
	local function flatDistance(p)
		return ((p - position) * Vector3.new(1, 0, 1)).Magnitude
	end

	-- food first
	local wrongFood
	for _, food in ipairs(foodFolder:GetChildren()) do
		if food.PrimaryPart and flatDistance(food.PrimaryPart.Position) < reach then
			local allowed = (food.Name == "Plant" and stats.plant) or (food.Name == "Meat" and stats.meat)
			if allowed then
				local xp = food:GetAttribute("Xp")
				local wasPlant = food.Name == "Plant"
				food:Destroy()
				humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 15)
				addXp(player, xp)
				if wasPlant then
					task.delay(8, spawnPlant)
				end
				return
			end
			wrongFood = food.Name
		end
	end

	-- then creatures
	local damage = stats.bite + stats.attack * 0.4 + stage * 2
	for other, npc in pairs(npcs) do
		if other.PrimaryPart and npc.humanoid.Health > 0 and flatDistance(other.PrimaryPart.Position) < reach + 1 then
			npc.attacker = player
			npc.angryUntil = now + 8
			npc.humanoid:TakeDamage(damage)
			return
		end
	end
	if Config.PvP then
		for _, otherPlayer in ipairs(Players:GetPlayers()) do
			local otherModel = otherPlayer.Character
			if otherPlayer ~= player and otherModel and otherModel.PrimaryPart and flatDistance(otherModel.PrimaryPart.Position) < reach then
				local h = otherModel:FindFirstChildOfClass("Humanoid")
				if h and (otherPlayer:GetAttribute("Stage") or 1) > 1 then
					h:TakeDamage(damage)
					return
				end
			end
		end
	end
	if wrongFood then
		notify:FireClient(player, "Your mouth can't eat " .. string.lower(wrongFood) .. ". Try another mouth in the creator.")
	end
end)

----------------------------------------------------------------------------
-- Start
----------------------------------------------------------------------------
buildWorld()

-- showcase creature framed by the MenuCamera
do
	local showcase = Data.random(Random.new(42))
	showcase.pattern = "Spots"
	showcase.colors = { 9, 16, 2 }
	local model = Builder.build(Data.sanitize(showcase), { scale = 1.1 })
	local spot = (menuCamera.CFrame * CFrame.new(3.5, 0, -16)).Position
	local standing = Vector3.new(spot.X, -model:GetAttribute("Ground"), spot.Z)
	local facing = Vector3.new(menuCamera.Position.X, standing.Y, menuCamera.Position.Z)
	model:PivotTo(CFrame.lookAt(standing, facing) * CFrame.Angles(0, math.rad(35), 0))
	model.PrimaryPart.Anchored = true
	model.Name = "MenuCreature"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	CollectionService:AddTag(model, "Creature")
	model.Parent = worldFolder
end

for _ = 1, Config.FoodCount do
	spawnPlant()
end
for _ = 1, Config.NpcCount do
	spawnNpc()
end

Players.PlayerAdded:Connect(loadProfile)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(loadProfile, player)
end
Players.PlayerRemoving:Connect(function(player)
	persist(player)
	if player.Character then
		player.Character:Destroy()
	end
	profiles[player] = nil
end)
game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		persist(player)
	end
end)

local accumulator = 0
RunService.Heartbeat:Connect(function(dt)
	accumulator += dt
	if accumulator < 0.3 then
		return
	end
	accumulator = 0
	local now = os.clock()
	for _, npc in pairs(npcs) do
		if npc.humanoid.Health > 0 then
			think(npc, now)
		end
	end
end)

-- slow health regeneration
task.spawn(function()
	while true do
		task.wait(1)
		for _, player in ipairs(Players:GetPlayers()) do
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 then
				humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + humanoid.MaxHealth * 0.01)
			end
		end
	end
end)

-- periodic autosave
task.spawn(function()
	while true do
		task.wait(120)
		for _, player in ipairs(Players:GetPlayers()) do
			persist(player)
		end
	end
end)
]]></ProtectedString></Properties></Item>
</Item>
<Item class="StarterPlayer" referent="RBX19"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX18"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX7"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local UI = require(script.Parent:WaitForChild("UIKit"))
local Editor = require(script.Parent:WaitForChild("Editor"))
local Animator = require(script.Parent:WaitForChild("Animator"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

playerGui.ScreenOrientation = Enum.ScreenOrientation.LandscapeSensor
task.spawn(function()
	for _ = 1, 10 do
		if pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, false) then
			break
		end
		task.wait(0.5)
	end
end)

Animator.start()

local profile = remotes:WaitForChild("GetProfile"):InvokeServer()
if not profile then
	return
end

local mode = "menu" -- menu, play, editor

local menuGui, menuRoot = UI.screen(playerGui, "MainMenu", 3)
local hudGui, hudRoot = UI.screen(playerGui, "HUD", 2)
hudGui.Enabled = false

local function setMode(new)
	mode = new
	menuGui.Enabled = new == "menu"
	hudGui.Enabled = new == "play"
	-- hide the thumbstick and jump button outside gameplay
	pcall(function()
		GuiService.TouchControlsEnabled = new == "play"
	end)
end

local function openEditor()
	local from = mode
	setMode("editor")
	remotes.Editing:FireServer(true)
	profile.xp = player:GetAttribute("Xp") or profile.xp
	Editor.open(profile, function()
		setMode(from)
		remotes.Editing:FireServer(false)
		if from == "play" then
			camera.CameraType = Enum.CameraType.Custom
		end
	end)
end

----------------------------------------------------------------------------
-- Main menu (camera sits on the MenuCamera part)
----------------------------------------------------------------------------
local title = UI.label(menuRoot, "EVOLVE", UDim2.fromOffset(420, 90), UDim2.fromOffset(40, 50), 80)
title.TextXAlignment = Enum.TextXAlignment.Left
title.Font = Enum.Font.FredokaOne
UI.make("UIStroke", { Thickness = 4, Color = UI.Dark }, title)
local subtitle = UI.label(menuRoot, "From hatchling to elder", UDim2.fromOffset(420, 30), UDim2.fromOffset(44, 140), 20)
subtitle.TextXAlignment = Enum.TextXAlignment.Left
UI.make("UIStroke", { Thickness = 2, Color = UI.Dark }, subtitle)

local help = UI.panel(menuRoot, UDim2.fromOffset(420, 260), UDim2.new(0.5, -210, 0.5, -130), 0.05)
help.Visible = false
help.ZIndex = 5
local helpText = UI.label(help, "Walk with the thumbstick, jump with the jump button.\n\nStand next to berry bushes or meat and tap BITE to eat. Your mouth decides what you can eat.\n\nEating grows you: Hatchling, Juvenile, Adolescent, Adult, Elder. Each stage unlocks more DNA.\n\nTap CREATE any time to change your body.", UDim2.new(1, -24, 1, -64), UDim2.fromOffset(12, 8), 15)
helpText.ZIndex = 6
local closeHelp = UI.button(help, "Got it", UDim2.fromOffset(160, 40), UDim2.new(0.5, -80, 1, -50), function()
	help.Visible = false
end, UI.Accent)
closeHelp.ZIndex = 6

local function menuButton(order, text, color, fn)
	local b = UI.button(menuRoot, text, UDim2.fromOffset(250, 56), UDim2.fromOffset(44, 200 + (order - 1) * 68), fn, color)
	b.TextSize = 22
	return b
end

menuButton(1, "PLAY", UI.Accent, function()
	if mode ~= "menu" then
		return
	end
	setMode("play")
	remotes.Play:FireServer()
end)
menuButton(2, "CREATURE CREATOR", UI.Panel, function()
	if mode == "menu" then
		openEditor()
	end
end)
menuButton(3, "HOW TO PLAY", UI.Panel, function()
	help.Visible = true
end)

----------------------------------------------------------------------------
-- HUD
----------------------------------------------------------------------------
local bar = UI.panel(hudRoot, UDim2.fromOffset(320, 54), UDim2.new(0.5, -160, 0, 6))
local stageLabel = UI.label(bar, "", UDim2.new(1, 0, 0, 24), UDim2.fromOffset(0, 3), 15)
local track = UI.panel(bar, UDim2.new(1, -20, 0, 8), UDim2.fromOffset(10, 29), 0)
track.BackgroundColor3 = UI.Panel
local fill = UI.panel(track, UDim2.fromScale(0, 1), UDim2.new(), 0)
fill.BackgroundColor3 = UI.Highlight
local hpTrack = UI.panel(bar, UDim2.new(1, -20, 0, 8), UDim2.fromOffset(10, 41), 0)
hpTrack.BackgroundColor3 = UI.Panel
local hpFill = UI.panel(hpTrack, UDim2.fromScale(1, 1), UDim2.new(), 0)
hpFill.BackgroundColor3 = UI.Warn

local toast = UI.label(hudRoot, "", UDim2.fromOffset(520, 40), UDim2.new(0.5, -260, 0, 66), 18)
UI.make("UIStroke", { Thickness = 2, Color = UI.Dark }, toast)
local toastId = 0
remotes.Notify.OnClientEvent:Connect(function(text)
	toastId += 1
	local mine = toastId
	toast.Text = text
	task.delay(3.5, function()
		if mine == toastId then
			toast.Text = ""
		end
	end)
end)

local function doBite()
	if mode == "play" then
		remotes.Bite:FireServer()
	end
end

local biteButton = UI.button(hudRoot, "BITE", UDim2.fromOffset(90, 90), UDim2.new(1, -250, 1, -120), doBite, UI.Warn)
UI.corner(biteButton, 45)
biteButton.TextSize = 22

local sprinting = false
local sprintButton
local function setSprint(on)
	sprinting = on
	sprintButton.BackgroundColor3 = on and UI.Highlight or UI.Panel
	remotes.Sprint:FireServer(on)
end
sprintButton = UI.button(hudRoot, "SPRINT", UDim2.fromOffset(72, 72), UDim2.new(1, -200, 1, -210), function()
	setSprint(not sprinting)
end)
UI.corner(sprintButton, 36)

UI.button(hudRoot, "CREATE", UDim2.fromOffset(96, 44), UDim2.new(1, -106, 0, 60), function()
	if mode == "play" then
		openEditor()
	end
end, UI.Accent)
UI.button(hudRoot, "MENU", UDim2.fromOffset(96, 44), UDim2.new(1, -106, 0, 110), function()
	setSprint(false)
	remotes.ToMenu:FireServer()
	setMode("menu")
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or mode ~= "play" then
		return
	end
	if input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonX then
		doBite()
	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		setSprint(true)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift and mode == "play" then
		setSprint(false)
	end
end)

----------------------------------------------------------------------------
-- Camera and HUD updates
----------------------------------------------------------------------------
player.CharacterAdded:Connect(function()
	sprinting = false
	sprintButton.BackgroundColor3 = UI.Panel
end)

RunService.RenderStepped:Connect(function()
	if mode == "menu" then
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = ReplicatedStorage:GetAttribute("MenuCFrame") or camera.CFrame
	elseif mode == "play" then
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			if camera.CameraType ~= Enum.CameraType.Custom or camera.CameraSubject ~= humanoid then
				camera.CameraType = Enum.CameraType.Custom
				camera.CameraSubject = humanoid
				local scale = character:GetAttribute("Scale") or 1
				player.CameraMaxZoomDistance = 50
				player.CameraMinZoomDistance = 8 + 8 * scale
				task.delay(0.3, function()
					player.CameraMinZoomDistance = 4
				end)
			end
			hpFill.Size = UDim2.fromScale(math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1), 1)
		end
		local xp = player:GetAttribute("Xp") or 0
		local index = Config.stageForXp(xp)
		local stage, nextStage = Config.Stages[index], Config.Stages[index + 1]
		if nextStage then
			stageLabel.Text = stage.name .. "  -  " .. (nextStage.xp - xp) .. " XP to " .. nextStage.name
			fill.Size = UDim2.fromScale((xp - stage.xp) / (nextStage.xp - stage.xp), 1)
		else
			stageLabel.Text = "Elder  -  fully grown"
			fill.Size = UDim2.fromScale(1, 1)
		end
	end
end)

setMode("menu")
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[-- Small helpers for touch-friendly UI.
local UIKit = {}

UIKit.Dark = Color3.fromRGB(24, 28, 44)
UIKit.Panel = Color3.fromRGB(38, 45, 70)
UIKit.Accent = Color3.fromRGB(72, 190, 130)
UIKit.Warn = Color3.fromRGB(225, 85, 85)
UIKit.Highlight = Color3.fromRGB(245, 180, 55)

function UIKit.make(class, props, parent)
	local o = Instance.new(class)
	for key, value in pairs(props) do
		o[key] = value
	end
	o.Parent = parent
	return o
end

function UIKit.corner(object, radius)
	UIKit.make("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, object)
	return object
end

function UIKit.panel(parent, size, position, transparency)
	local f = UIKit.make("Frame", {
		Size = size, Position = position, BackgroundColor3 = UIKit.Dark,
		BackgroundTransparency = transparency or 0.15, BorderSizePixel = 0,
		Active = true,
	}, parent)
	return UIKit.corner(f, 12)
end

function UIKit.label(parent, text, size, position, textSize)
	return UIKit.make("TextLabel", {
		Text = text, Size = size, Position = position or UDim2.new(),
		BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamBold, TextSize = textSize or 16, TextWrapped = true,
	}, parent)
end

function UIKit.button(parent, text, size, position, callback, color)
	local b = UIKit.make("TextButton", {
		Text = text, Size = size, Position = position or UDim2.new(),
		BackgroundColor3 = color or UIKit.Panel, TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamBold, TextSize = 15, TextWrapped = true,
		AutoButtonColor = true, BorderSizePixel = 0,
	}, parent)
	UIKit.corner(b, 10)
	if callback then
		b.Activated:Connect(function()
			callback(b)
		end)
	end
	return b
end

function UIKit.grid(parent, size, position, cell)
	local scroll = UIKit.make("ScrollingFrame", {
		Size = size, Position = position, BackgroundTransparency = 1, BorderSizePixel = 0,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 5, ScrollingDirection = Enum.ScrollingDirection.Y,
	}, parent)
	UIKit.make("UIGridLayout", {
		CellSize = cell, CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder,
	}, scroll)
	return scroll
end

-- A full-screen root that scales to phones and tablets.
function UIKit.screen(playerGui, name, order)
	local gui = UIKit.make("ScreenGui", {
		Name = name, ResetOnSpawn = false, DisplayOrder = order or 1,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)
	local root = UIKit.make("Frame", { Name = "Root", BackgroundTransparency = 1 }, gui)
	local scale = UIKit.make("UIScale", {}, root)
	local function resize()
		local view = workspace.CurrentCamera.ViewportSize
		local s = math.clamp(math.min(view.Y / 520, view.X / 900), 0.5, 1.5)
		scale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize)
	resize()
	return gui, root
end

return UIKit
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Editor</string><ProtectedString name="Source"><![CDATA[-- The creature creator: body shaping, parts, sculpting and painting. Touch and mouse.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("PartCatalog"))
local Data = require(Shared:WaitForChild("CreatureData"))
local Builder = require(Shared:WaitForChild("CreatureBuilder"))
local UI = require(script.Parent.UIKit)

local Editor = {}

local STUDIO = Vector3.new(0, 600, 0)
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local state -- nil while closed

local function copy(t)
	return HttpService:JSONDecode(HttpService:JSONEncode(t))
end

local function round(v)
	return math.floor(v * 100 + 0.5) / 100
end

local function pack3(v)
	return { round(v.X), round(v.Y), round(v.Z) }
end

local function updateCamera()
	local rotation = CFrame.Angles(0, state.yaw, 0) * CFrame.Angles(state.pitch, 0, 0)
	local focus = STUDIO
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(focus + rotation:VectorToWorldSpace(Vector3.new(0, 0, state.distance)), focus)
end

local function message(text)
	state.status.Text = text
end

local function refreshInfo()
	local stage = Config.Stages[state.stage]
	local stats = Data.stats(state.data, state.stage)
	local used = Data.cost(state.data)
	state.info.Text = string.format(
		"%s  |  DNA %d/%d  |  Sculpt %d/%d\n%s   HP %d   Speed %d   Jump %d   Attack %d   Sense %d   Charm %d",
		stage.name, used, stage.dna, #state.data.sculpt, stage.sculpt,
		stats.diet, math.floor(stats.health), math.floor(stats.speed), math.floor(stats.jump),
		math.floor(stats.bite + stats.attack), math.floor(stats.sense), math.floor(stats.charm)
	)
end

local function rebuild()
	if state.model then
		state.model:Destroy()
	end
	local model, info = Builder.build(state.data, { scale = 1, anchored = true })
	model:PivotTo(CFrame.new(STUDIO))
	model.Parent = workspace
	state.model, state.shapes, state.hits = model, info.shapes, info.hits
	state.floor.CFrame = CFrame.new(STUDIO + Vector3.new(0, info.ground - 0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2)

	-- outline the selection
	local marker = state.marker
	marker.Transparency = 1
	if state.mode == "Parts" and state.selected then
		for _, hit in ipairs(state.hits) do
			if hit.part == state.selected then
				marker.Size = Vector3.one * math.max(hit.r * 2.4, 0.8)
				marker.CFrame = CFrame.new(STUDIO + hit.c)
				marker.Transparency = 0.65
				break
			end
		end
	elseif state.mode == "Body" then
		local e = state.shapes[state.segment]
		if e then
			marker.Size = Vector3.one * (e.r.X * 2 + 0.25)
			marker.CFrame = CFrame.new(STUDIO + e.c)
			marker.Transparency = 0.65
		end
	end
	refreshInfo()
end

local function remember()
	table.insert(state.undo, copy(state.data))
	if #state.undo > 40 then
		table.remove(state.undo, 1)
	end
end

-- when the body is reshaped, carry parts and sculpting along with the skin
local function reseat(before, after)
	local old, new = Builder.ellipsoids(before), Builder.ellipsoids(after)
	local oldCount, newCount = #before.spine, #after.spine
	for _, list in ipairs({ after.parts, after.sculpt }) do
		for _, e in ipairs(list) do
			local p = Vector3.new(e.pos[1], e.pos[2], e.pos[3])
			local index, best = 1, math.huge
			for i, shape in ipairs(old) do
				local d = math.abs(((p - shape.c) / shape.r).Magnitude - 1)
				if d < best then
					index, best = i, d
				end
			end
			local from = old[index]
			local to
			if from.head then
				to = new[#new]
			else
				local t = (index - 1) / math.max(oldCount - 1, 1)
				to = new[math.floor(t * (newCount - 1) + 0.5) + 1]
			end
			e.pos = pack3(to.c + (p - from.c) / from.r * to.r)
		end
	end
end

-- apply an edit, rejecting it if it would break the DNA or sculpt limits
local function change(fn)
	local before = copy(state.data)
	fn(state.data)
	local costUp = Data.cost(state.data) > Data.cost(before)
	local sculptUp = #state.data.sculpt > #before.sculpt
	local stage = Config.Stages[state.stage]
	if (costUp and Data.cost(state.data) > stage.dna) or (sculptUp and #state.data.sculpt > stage.sculpt) then
		state.data = before
		message("Not enough room yet. Grow up to unlock more!")
		return false
	end
	if #state.data.parts > Config.MaxParts then
		state.data = before
		message("Part limit reached.")
		return false
	end
	local function body(d)
		return HttpService:JSONEncode({ d.spine, d.head })
	end
	if body(before) ~= body(state.data) then
		reseat(before, state.data)
	end
	table.insert(state.undo, before)
	if #state.undo > 40 then
		table.remove(state.undo, 1)
	end
	rebuild()
	return true
end

----------------------------------------------------------------------------
-- Tapping on the creature
----------------------------------------------------------------------------
local function bodyRay(screen)
	local ray = camera:ScreenPointToRay(screen.X, screen.Y)
	return ray.Origin - STUDIO, ray.Direction.Unit
end

local function pickSphere(origin, dir, key)
	local best, bestT
	for _, hit in ipairs(state.hits) do
		if hit[key] then
			local t = (hit.c - origin):Dot(dir)
			if t > 0 and (origin + dir * t - hit.c).Magnitude < hit.r and (not bestT or t < bestT) then
				best, bestT = hit[key], t
			end
		end
	end
	return best
end

-- returns surface position and normal, snapped to the centre line when close
local function surfacePoint(screen)
	local origin, dir = bodyRay(screen)
	local pos, normal = Builder.raycast(state.shapes, origin, dir)
	if pos and math.abs(pos.X) < 0.18 then
		pos = Vector3.new(0, pos.Y, pos.Z)
		normal = Vector3.new(0, normal.Y, normal.Z).Unit
	end
	return pos, normal
end

local renderPanel -- forward declaration

local function sculptAt(screen, continuing)
	if state.erase then
		local origin, dir = bodyRay(screen)
		local index = pickSphere(origin, dir, "dab")
		if index then
			if not state.strokeSaved then
				remember()
				state.strokeSaved = true
			end
			table.remove(state.data.sculpt, index)
			rebuild()
		end
		return
	end
	local pos, normal = surfacePoint(screen)
	if not pos then
		return
	end
	if continuing and state.lastDab and (state.lastDab - pos).Magnitude < state.brushSize * 0.6 then
		return
	end
	if #state.data.sculpt >= Config.Stages[state.stage].sculpt then
		message("Sculpt limit reached. Grow up for more!")
		return
	end
	if not state.strokeSaved then
		remember() -- one undo step per stroke
		state.strokeSaved = true
	end
	state.lastDab = pos
	table.insert(state.data.sculpt, {
		b = state.brush, pos = pack3(pos), nrm = pack3(normal), s = state.brushSize,
		c = state.brushColor, m = state.mirror and math.abs(pos.X) > 0.01,
	})
	rebuild()
end

local function tap(screen)
	if state.mode == "Parts" then
		if state.pending or state.moving then
			local pos, normal = surfacePoint(screen)
			if not pos then
				message("Tap on the body or head.")
				return
			end
			local mirrored = state.mirror and math.abs(pos.X) > 0.01
			if state.moving and state.selected then
				change(function(d)
					local e = d.parts[state.selected]
					e.pos, e.nrm, e.m = pack3(pos), pack3(normal), mirrored
				end)
				state.moving = false
			else
				local id = state.pending
				local added = change(function(d)
					table.insert(d.parts, { id = id, pos = pack3(pos), nrm = pack3(normal), s = 1, rot = 0, m = mirrored })
				end)
				if added then
					state.pending = nil
					state.selected = #state.data.parts
					rebuild()
				end
			end
		else
			local origin, dir = bodyRay(screen)
			state.selected = pickSphere(origin, dir, "part")
			rebuild()
		end
		renderPanel()
	elseif state.mode == "Body" then
		local origin, dir = bodyRay(screen)
		local _, _, _, shape = Builder.raycast(state.shapes, origin, dir)
		if shape and shape.index then
			state.segment = shape.index
			rebuild()
			renderPanel()
		end
	end
end

----------------------------------------------------------------------------
-- Side panel
----------------------------------------------------------------------------
local function row(parent, y, items)
	local n = #items
	for i, item in ipairs(items) do
		UI.button(parent, item[1], UDim2.new(1 / n, -6, 0, 38), UDim2.new((i - 1) / n, 3, 0, y), item[2], item[3])
	end
end

local function swatches(parent, y, height, callback)
	local grid = UI.grid(parent, UDim2.new(1, -8, 0, height), UDim2.fromOffset(4, y), UDim2.fromOffset(34, 34))
	for i, color in ipairs(Catalog.Palette) do
		local b = UI.button(grid, "", UDim2.new(), nil, function()
			callback(i)
		end, color)
		b.LayoutOrder = i
	end
end

local function clampSegment()
	state.segment = math.clamp(state.segment, 1, #state.data.spine)
end

function renderPanel()
	local panel = state.panel
	panel:ClearAllChildren()
	UI.corner(panel, 12)

	if state.mode == "Parts" then
		if state.selected and state.data.parts[state.selected] then
			local entry = state.data.parts[state.selected]
			local def = Catalog.Parts[entry.id]
			UI.label(panel, def.name .. " selected", UDim2.new(1, 0, 0, 30), UDim2.fromOffset(0, 4))
			local function edit(fn)
				return function()
					change(function(d)
						fn(d.parts[state.selected])
					end)
				end
			end
			row(panel, 38, {
				{ "Smaller", edit(function(e) e.s = math.max(0.4, e.s - 0.15) end) },
				{ "Bigger", edit(function(e) e.s = math.min(2.2, e.s + 0.15) end) },
			})
			row(panel, 82, {
				{ "Turn -", edit(function(e) e.rot = (e.rot - 20) % 360 end) },
				{ "Turn +", edit(function(e) e.rot = (e.rot + 20) % 360 end) },
			})
			row(panel, 126, {
				{ "Move", function() state.moving = true; message("Tap the new spot.") end },
				{ "Delete", function()
					local index = state.selected
					state.selected = nil
					change(function(d) table.remove(d.parts, index) end)
					renderPanel()
				end, UI.Warn },
			})
			row(panel, 170, {
				{ "Done", function() state.selected = nil; state.moving = false; rebuild(); renderPanel() end, UI.Accent },
			})
			UI.label(panel, "Part color", UDim2.new(1, 0, 0, 24), UDim2.fromOffset(0, 214), 14)
			swatches(panel, 240, 130, function(i)
				change(function(d) d.parts[state.selected].c = i end)
			end)
		else
			local tabs = UI.grid(panel, UDim2.new(1, -8, 0, 76), UDim2.fromOffset(4, 6), UDim2.new(0.25, -6, 0, 34))
			for i, category in ipairs(Catalog.Categories) do
				local b = UI.button(tabs, category, UDim2.new(), nil, function()
					state.category = category
					renderPanel()
				end, category == state.category and UI.Highlight or UI.Panel)
				b.TextSize = 12
				b.LayoutOrder = i
			end
			local list = UI.grid(panel, UDim2.new(1, -8, 1, -90), UDim2.fromOffset(4, 86), UDim2.new(0.5, -6, 0, 52))
			for i, def in ipairs(Catalog.ByCategory[state.category]) do
				local b = UI.button(list, def.name .. "\n" .. def.cost .. " DNA", UDim2.new(), nil, function()
					state.pending = def.id
					message("Tap the creature to place: " .. def.name)
					renderPanel()
				end, state.pending == def.id and UI.Highlight or UI.Panel)
				b.TextSize = 13
				b.LayoutOrder = i
			end
		end
	elseif state.mode == "Body" then
		clampSegment()
		local function seg(fn)
			return function()
				change(function(d)
					fn(d.spine[state.segment])
				end)
			end
		end
		UI.label(panel, "Segment " .. state.segment .. " of " .. #state.data.spine .. " (tap body to pick)", UDim2.new(1, 0, 0, 30), UDim2.fromOffset(0, 2), 13)
		row(panel, 34, {
			{ "Thinner", seg(function(v) v.r = math.max(0.3, v.r - 0.12) end) },
			{ "Fatter", seg(function(v) v.r = math.min(2, v.r + 0.12) end) },
		})
		row(panel, 76, {
			{ "Lower", seg(function(v) v.y = math.max(-2, v.y - 0.2) end) },
			{ "Raise", seg(function(v) v.y = math.min(3, v.y + 0.2) end) },
		})
		row(panel, 118, {
			{ "- Segment", function()
				if #state.data.spine > Config.MinSegments then
					change(function(d) table.remove(d.spine, state.segment) end)
					clampSegment()
					rebuild()
					renderPanel()
				end
			end },
			{ "+ Segment", function()
				if #state.data.spine < Config.MaxSegments then
					change(function(d)
						local v = d.spine[state.segment]
						table.insert(d.spine, state.segment, { r = v.r, y = v.y })
					end)
					renderPanel()
				end
			end },
		})
		UI.label(panel, "Head shape", UDim2.new(1, 0, 0, 24), UDim2.fromOffset(0, 162), 14)
		local heads = UI.grid(panel, UDim2.new(1, -8, 0, 124), UDim2.fromOffset(4, 188), UDim2.new(0.333, -6, 0, 36))
		for i, head in ipairs(Catalog.Heads) do
			local b = UI.button(heads, head.name, UDim2.new(), nil, function()
				change(function(d) d.head.id = head.id end)
				renderPanel()
			end, state.data.head.id == head.id and UI.Highlight or UI.Panel)
			b.LayoutOrder = i
		end
		row(panel, 318, {
			{ "Head -", function() change(function(d) d.head.scale = math.max(0.5, d.head.scale - 0.12) end) end },
			{ "Head +", function() change(function(d) d.head.scale = math.min(2, d.head.scale + 0.12) end) end },
		})
	elseif state.mode == "Sculpt" then
		local brushes = UI.grid(panel, UDim2.new(1, -8, 0, 124), UDim2.fromOffset(4, 6), UDim2.new(0.333, -6, 0, 36))
		for i, name in ipairs(Catalog.Brushes) do
			local b = UI.button(brushes, name, UDim2.new(), nil, function()
				state.brush = name
				state.erase = false
				renderPanel()
			end, (state.brush == name and not state.erase) and UI.Highlight or UI.Panel)
			b.LayoutOrder = i
		end
		UI.label(panel, string.format("Brush size %.2f", state.brushSize), UDim2.new(1, 0, 0, 22), UDim2.fromOffset(0, 132), 14)
		row(panel, 156, {
			{ "Size -", function() state.brushSize = math.max(0.1, state.brushSize - 0.1); renderPanel() end },
			{ "Size +", function() state.brushSize = math.min(1.5, state.brushSize + 0.1); renderPanel() end },
		})
		row(panel, 198, {
			{ state.erase and "Erasing" or "Eraser", function() state.erase = not state.erase; renderPanel() end, state.erase and UI.Warn or UI.Panel },
			{ "Clear all", function() change(function(d) table.clear(d.sculpt) end) end },
		})
		UI.label(panel, "Drag on the body to sculpt. Drag empty space to spin.", UDim2.new(1, -8, 0, 34), UDim2.fromOffset(4, 240), 12)
		swatches(panel, 278, 110, function(i)
			state.brushColor = i
			message("Brush color changed.")
		end)
	elseif state.mode == "Paint" then
		local names = { "Body", "Belly", "Accent" }
		local picks = {}
		for i, name in ipairs(names) do
			picks[i] = { name, function() state.slot = i; renderPanel() end, state.slot == i and UI.Highlight or UI.Panel }
		end
		row(panel, 6, picks)
		swatches(panel, 50, 160, function(i)
			change(function(d) d.colors[state.slot] = i end)
		end)
		local patterns = UI.grid(panel, UDim2.new(1, -8, 0, 40), UDim2.fromOffset(4, 216), UDim2.new(0.25, -6, 0, 36))
		for i, name in ipairs(Catalog.Patterns) do
			local b = UI.button(patterns, name, UDim2.new(), nil, function()
				change(function(d) d.pattern = name end)
				renderPanel()
			end, state.data.pattern == name and UI.Highlight or UI.Panel)
			b.LayoutOrder = i
		end
		local materials = UI.grid(panel, UDim2.new(1, -8, 1, -266), UDim2.fromOffset(4, 262), UDim2.new(0.333, -6, 0, 34))
		for i, name in ipairs(Catalog.Materials) do
			local b = UI.button(materials, name == "SmoothPlastic" and "Smooth" or name, UDim2.new(), nil, function()
				change(function(d) d.material = name end)
				renderPanel()
			end, state.data.material == name and UI.Highlight or UI.Panel)
			b.TextSize = 12
			b.LayoutOrder = i
		end
	end
end

----------------------------------------------------------------------------
-- Input: drag to spin, tap to place, pinch or wheel to zoom
----------------------------------------------------------------------------
local function connectInput()
	local active -- the one finger or mouse button we are tracking
	local connections = state.connections

	local function isPointer(input)
		return input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1
	end

	table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not isPointer(input) then
			return
		end
		if active then
			active.cancelled = true -- second finger: it is a pinch
			return
		end
		local screen = Vector2.new(input.Position.X, input.Position.Y)
		active = { input = input, start = screen, last = screen, moved = false, sculpting = false }
		state.strokeSaved = false
		if state.mode == "Sculpt" then
			local origin, dir = bodyRay(screen)
			if Builder.raycast(state.shapes, origin, dir) or (state.erase and pickSphere(origin, dir, "dab")) then
				active.sculpting = true
				state.lastDab = nil
			end
		end
	end))

	table.insert(connections, UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			state.distance = math.clamp(state.distance - input.Position.Z * 1.5, 5, 40)
			updateCamera()
			return
		end
		if not active then
			return
		end
		local same = input == active.input
			or (active.input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
		if not same or active.cancelled then
			return
		end
		local screen = Vector2.new(input.Position.X, input.Position.Y)
		local delta = screen - active.last
		active.last = screen
		if (screen - active.start).Magnitude > 10 then
			active.moved = true
		end
		if active.moved then
			if active.sculpting then
				sculptAt(screen, active.stroked)
				active.stroked = true
			else
				state.yaw -= delta.X * 0.01
				state.pitch = math.clamp(state.pitch - delta.Y * 0.008, -1.3, 1.0)
				updateCamera()
			end
		end
	end))

	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if not active or input ~= active.input and not (isPointer(input) and input.UserInputType == active.input.UserInputType and input.UserInputType == Enum.UserInputType.MouseButton1) then
			return
		end
		if not active.cancelled and not active.moved then
			if active.sculpting then
				sculptAt(active.start, false)
			else
				tap(active.start)
			end
		end
		active = nil
	end))

	local pinchStart
	table.insert(connections, UserInputService.TouchPinch:Connect(function(_, scale, _, inputState, processed)
		if inputState == Enum.UserInputState.Begin or not pinchStart then
			pinchStart = state.distance / math.max(scale, 0.05)
		end
		if not processed then
			state.distance = math.clamp(pinchStart / math.max(scale, 0.05), 5, 40)
			updateCamera()
		end
		if inputState == Enum.UserInputState.End then
			pinchStart = nil
		end
	end))
end

----------------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------------
function Editor.close()
	if not state then
		return
	end
	for _, c in ipairs(state.connections) do
		c:Disconnect()
	end
	state.model:Destroy()
	state.floor:Destroy()
	state.marker:Destroy()
	state.gui:Destroy()
	local done = state.onClose
	state = nil
	done()
end

function Editor.open(profile, onClose)
	if state then
		return
	end
	local gui, root = UI.screen(player:WaitForChild("PlayerGui"), "CreatureEditor", 5)
	state = {
		data = copy(profile.data), stage = Config.stageForXp(profile.xp), onClose = onClose,
		gui = gui, undo = {}, connections = {}, mode = "Parts", category = "Mouths",
		mirror = true, segment = 1, brush = "Blob", brushSize = 0.4, brushColor = 3, slot = 1,
		yaw = math.rad(215), pitch = -0.25, distance = 14,
	}

	local function studioPart(name)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CastShadow = false
		p.Parent = workspace
		return p
	end
	state.floor = studioPart("EditorFloor")
	state.floor.Shape = Enum.PartType.Cylinder
	state.floor.Size = Vector3.new(1, 14, 14)
	state.floor.Color = Color3.fromRGB(90, 105, 150)
	state.marker = studioPart("EditorMarker")
	state.marker.Shape = Enum.PartType.Ball
	state.marker.Material = Enum.Material.ForceField
	state.marker.Color = Color3.fromRGB(255, 220, 60)
	state.marker.Transparency = 1

	local top = UI.panel(root, UDim2.new(1, -470, 0, 56), UDim2.fromOffset(300, 6))
	state.info = UI.label(top, "", UDim2.new(1, -10, 1, 0), UDim2.fromOffset(5, 0), 13)
	local status = UI.panel(root, UDim2.new(1, -620, 0, 34), UDim2.new(0, 300, 1, -42), 0.3)
	state.status = UI.label(status, "Pick a part, then tap the creature.", UDim2.fromScale(1, 1), nil, 13)

	local left = UI.panel(root, UDim2.fromOffset(284, 40), UDim2.fromOffset(8, 54))
	state.panel = UI.panel(root, UDim2.new(0, 284, 1, -108), UDim2.fromOffset(8, 100))
	local modeButtons = {}
	for i, mode in ipairs({ "Parts", "Body", "Sculpt", "Paint" }) do
		modeButtons[mode] = UI.button(left, mode, UDim2.new(0.25, -4, 1, -4), UDim2.new((i - 1) / 4, 2, 0, 2), function()
			state.mode = mode
			state.selected, state.pending, state.moving = nil, nil, false
			for name, b in pairs(modeButtons) do
				b.BackgroundColor3 = name == mode and UI.Accent or UI.Panel
			end
			message(mode == "Sculpt" and "Drag on the creature to sculpt." or "")
			rebuild()
			renderPanel()
		end, mode == state.mode and UI.Accent or UI.Panel)
	end

	local right = UI.panel(root, UDim2.fromOffset(140, 330), UDim2.new(1, -148, 0, 6))
	local nameBox = UI.make("TextBox", {
		Text = state.data.name, PlaceholderText = "Name", ClearTextOnFocus = false,
		Size = UDim2.new(1, -12, 0, 38), Position = UDim2.fromOffset(6, 6),
		BackgroundColor3 = UI.Panel, TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamBold, TextSize = 15,
	}, right)
	UI.corner(nameBox)
	nameBox.FocusLost:Connect(function()
		if state then
			state.data.name = string.sub(nameBox.Text, 1, 20)
		end
	end)
	local function side(y, text, fn, color)
		return UI.button(right, text, UDim2.new(1, -12, 0, 38), UDim2.fromOffset(6, y), fn, color)
	end
	side(50, "Mirror: ON", function(b)
		state.mirror = not state.mirror
		b.Text = "Mirror: " .. (state.mirror and "ON" or "OFF")
	end)
	side(94, "Undo", function()
		local previous = table.remove(state.undo)
		if previous then
			state.data = previous
			state.selected = nil
			clampSegment()
			rebuild()
			renderPanel()
		end
	end)
	side(138, "Zoom +", function() state.distance = math.max(5, state.distance - 2.5); updateCamera() end)
	side(182, "Zoom -", function() state.distance = math.min(40, state.distance + 2.5); updateCamera() end)
	local saving = false
	side(232, "SAVE", function()
		if saving then
			return
		end
		saving = true
		state.data.name = string.sub(nameBox.Text, 1, 20)
		message("Saving...")
		local opened = state
		local ok, success, reason = pcall(function()
			return ReplicatedStorage.Remotes.SaveCreature:InvokeServer(state.data)
		end)
		saving = false
		if state ~= opened then
			return
		end
		if ok and success then
			profile.data = copy(state.data)
			Editor.close()
		else
			message(ok and tostring(reason) or "Save failed, try again.")
		end
	end, UI.Accent)
	side(276, "Cancel", function() Editor.close() end, UI.Warn)

	connectInput()
	rebuild()
	renderPanel()
	updateCamera()
end

return Editor
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Animator</string><ProtectedString name="Source"><![CDATA[-- Client-side procedural animation: IK legs and arms, tail sway, wing flap, head bite.
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local IK = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("IK"))

local Animator = {}
local rigs = {}
local restPose = setmetatable({}, { __mode = "k" })
local watched = setmetatable({}, { __mode = "k" })

local function scan(model)
	local root = model.PrimaryPart
	if not root then
		return nil
	end
	local rig = { model = model, root = root, limbs = {}, swing = {}, phase = 0, biteAt = -10, last = root.Position }
	for _, motor in ipairs(root:GetChildren()) do
		if motor:IsA("Motor6D") then
			local kind = motor:GetAttribute("Kind")
			if kind == "Limb" then
				local name = motor:GetAttribute("Limb")
				local lower = root:FindFirstChild(name .. "_L")
				local foot = root:FindFirstChild(name .. "_F")
				if lower and foot then
					table.insert(rig.limbs, {
						upper = motor, lower = lower, foot = foot,
						hip = motor:GetAttribute("Hip"), rest = motor:GetAttribute("Rest"),
						l1 = motor:GetAttribute("L1"), l2 = motor:GetAttribute("L2"),
						pole = motor:GetAttribute("Pole"), arm = motor:GetAttribute("Arm"),
						group = motor:GetAttribute("Group"),
					})
				end
			elseif kind then
				restPose[motor] = restPose[motor] or motor.C0
				table.insert(rig.swing, {
					motor = motor, kind = kind, rest = restPose[motor],
					pivot = motor:GetAttribute("Pivot"),
					index = motor:GetAttribute("Index"), side = motor:GetAttribute("Side"),
				})
			end
		end
	end
	if not watched[model] then
		watched[model] = true
		model:GetAttributeChangedSignal("Bite"):Connect(function()
			if rigs[model] then
				rigs[model].biteAt = os.clock()
			end
		end)
	end
	rig.count = #root:GetChildren()
	return rig
end

local function updateLimb(rig, limb, speed, params, time)
	local rootCF = rig.root.CFrame
	local scale = rig.model:GetAttribute("Scale") or 1
	local target

	if limb.arm then
		local swing = math.sin(rig.phase + limb.group * math.pi) * math.min(speed / 12, 1) * 0.6 * scale
		local reach = math.clamp(1 - (time - rig.biteAt) / 0.35, 0, 1)
		target = limb.rest + Vector3.new(0, math.sin(time * 2) * 0.08 * scale + reach * scale, swing - reach * 1.5 * scale)
	else
		local home = rootCF:PointToWorldSpace(limb.rest)
		local hit = workspace:Raycast(home + Vector3.new(0, 3 * scale, 0), Vector3.new(0, -8 * scale - 2, 0), params)
		local ground = hit and hit.Position + Vector3.new(0, 0.15 * scale, 0) or home

		if not limb.planted or (limb.planted - ground).Magnitude > 6 * scale then
			limb.planted = ground
			limb.stepStart = nil
		end
		local velocity = rig.root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
		local stride = 1.1 * scale
		if limb.stepStart then
			local duration = math.clamp(1.6 * scale / math.max(speed, 6), 0.08, 0.25)
			local t = math.min((time - limb.stepStart) / duration, 1)
			local goal = ground + velocity * duration * 0.5
			local lifted = limb.from:Lerp(goal, t) + Vector3.new(0, math.sin(t * math.pi) * 0.7 * scale, 0)
			if t >= 1 then
				limb.planted = goal
				limb.stepStart = nil
			end
			target = rootCF:PointToObjectSpace(lifted)
		else
			local drift = (limb.planted - ground).Magnitude
			local myTurn = math.floor(rig.phase / math.pi) % 2 == limb.group
			-- step on this leg group's beat, or at once if badly stretched
			if (drift > stride and myTurn) or drift > stride * 2.2 or (speed < 0.5 and drift > 0.35 * scale) then
				limb.from = limb.planted
				limb.stepStart = time
			end
			target = rootCF:PointToObjectSpace(limb.planted)
		end
		-- tuck the legs while airborne
		if math.abs(rig.root.AssemblyLinearVelocity.Y) > 8 then
			target = limb.rest + Vector3.new(0, 0.5 * scale, 0)
			limb.planted = nil
		end
	end

	local knee, foot = IK.solve(limb.hip, target, limb.l1, limb.l2, limb.pole)
	limb.upper.C0 = IK.bone(limb.hip, knee)
	limb.lower.C0 = IK.bone(knee, foot)
	limb.foot.C0 = CFrame.new(foot)
end

local function updateSwing(rig, item, speed, time)
	local rotation
	if item.kind == "Tail" then
		local wave = math.sin(time * (2 + speed * 0.25) - item.index * 0.55) * 0.07 * item.index
		rotation = CFrame.Angles(0, wave, 0)
	elseif item.kind == "Wing" then
		local airborne = math.abs(rig.root.AssemblyLinearVelocity.Y) > 4
		local flap = math.sin(time * (airborne and 16 or 2.5)) * (airborne and 0.8 or 0.12)
		rotation = CFrame.Angles(0, 0, flap * item.side)
	else
		local t = (time - rig.biteAt) / 0.35
		local lunge = (t >= 0 and t <= 1) and math.sin(t * math.pi) or 0
		rotation = CFrame.Angles(-lunge * 0.5 + math.sin(time * 1.7) * 0.03, math.sin(time * 0.6) * 0.08, 0)
			+ Vector3.new(0, 0, -lunge * 0.6)
	end
	item.motor.C0 = CFrame.new(item.pivot) * rotation * CFrame.new(-item.pivot) * item.rest
end

function Animator.start()
	local function forget(model)
		rigs[model] = nil
	end
	CollectionService:GetInstanceRemovedSignal("Creature"):Connect(forget)

	RunService.PreSimulation:Connect(function(dt)
		local camera = workspace.CurrentCamera
		local time = os.clock()
		for _, model in ipairs(CollectionService:GetTagged("Creature")) do
			local root = model.PrimaryPart
			-- skip far away creatures to save battery on phones
			if root and model:IsDescendantOf(workspace) and (camera.CFrame.Position - root.Position).Magnitude < 130 then
				local rig = rigs[model]
				if not rig or rig.root ~= root or rig.count ~= #root:GetChildren() then
					rig = scan(model)
					rigs[model] = rig
				end
				if rig then
					local speed = (root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude
					rig.phase += dt * math.clamp(speed * 1.1, 3, 22)
					local params = RaycastParams.new()
					params.FilterType = Enum.RaycastFilterType.Exclude
					local ignore = CollectionService:GetTagged("Creature")
					local food = workspace:FindFirstChild("Food")
					if food then
						table.insert(ignore, food)
					end
					params.FilterDescendantsInstances = ignore
					for _, limb in ipairs(rig.limbs) do
						updateLimb(rig, limb, speed, params, time)
					end
					for _, item in ipairs(rig.swing) do
						updateSwing(rig, item, speed, time)
					end
				end
			end
		end
	end)
end

return Animator
]]></ProtectedString></Properties></Item>
</Item>
</Item>
